---
import AuthLayout from "@/layouts/AuthLayout.astro";
import Input from "@/components/ui/Input.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
---

<AuthLayout
  title="Forgot password"
  heading="Forgot your password?"
  subtitle="Enter your email and we'll send you a link to reset it."
>
  <form class="space-y-5" onsubmit="event.preventDefault();">
    <Input
      label="Email"
      name="email"
      type="email"
      placeholder="you@example.com"
      icon="mail"
      autocomplete="email"
      required
    />
    <Button type="submit" size="lg" block icon="mail">Send reset link</Button>
  </form>

  <div class="mt-6 flex items-start gap-2.5 rounded-[12px] border border-brand-200 bg-brand-50 p-4">
    <Icon name="info" size={16} class="mt-0.5 shrink-0 text-brand-700" />
    <p class="text-xs leading-relaxed text-brand-800">
      For security, we send reset links only to registered email addresses. The
      link expires after 30 minutes.
    </p>
  </div>

  <p class="mt-8 text-center text-sm text-muted">
    Remembered it?
    <a href="/login" class="font-semibold text-accent hover:text-accent-hover">
      Back to login
    </a>
  </p>
</AuthLayout>
