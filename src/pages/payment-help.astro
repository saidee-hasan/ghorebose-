---
import ContentPage from "@/layouts/ContentPage.astro";
import Prose from "@/components/ui/Prose.astro";
import Icon from "@/components/ui/Icon.astro";
import FaqAccordion from "@/components/marketplace/FaqAccordion.astro";

const methods = [
  {
    name: "bKash (বিকাশ)",
    badgeColor: "bg-[#D12053] text-white",
    number: "01712-345678",
    type: "Personal Account (সেন্ড মানি)",
    steps: [
      "আপনার bKash অ্যাপে লগইন করুন অথবা *247# ডায়াল করুন।",
      "হোম স্ক্রিন থেকে 'Send Money' (সেন্ড মানি) অপশন নির্বাচন করুন।",
      "প্রাপক নাম্বারে আমাদের নাম্বার 01712-345678 দিন।",
      "চেকআউটে উল্লেখিত সঠিক টাকার পরিমাণ (Exact Amount) লিখুন।",
      "আপনার বিকাশ পিন নম্বর দিয়ে সেন্ড মানি কনফার্ম করুন।",
      "লেনদেন সফল হওয়ার পর SMS থেকে ৮-১০ ডিজিটের Transaction ID (TrxID) কপি করুন।",
    ],
  },
  {
    name: "Nagad (নগদ)",
    badgeColor: "bg-[#F7931E] text-white",
    number: "01812-345678",
    type: "Personal Account (সেন্ড মানি)",
    steps: [
      "আপনার Nagad অ্যাপে প্রবেশ করুন অথবা *167# ডায়াল করুন।",
      "মেনু থেকে 'Send Money' (সেন্ড মানি) বেছে নিন।",
      "প্রাপক নাম্বারে আমাদের নাম্বার 01812-345678 প্রবেশ করান।",
      "চেকআউটের মোট টাকার পরিমাণ টাইপ করুন।",
      "আপনার নগদ পিন দিয়ে ট্যাপ করে ধরে রাখুন।",
      "কনফার্মেশন মেসেজ থেকে Transaction ID কপি করে চেকআউট ফর্মে দিন।",
    ],
  },
  {
    name: "Rocket (রকেট)",
    badgeColor: "bg-[#8C3494] text-white",
    number: "01912-345678",
    type: "Personal Account (সেন্ড মানি)",
    steps: [
      "Rocket অ্যাপ চালু করুন অথবা *322# ডায়াল করুন।",
      "Send Money অপশন সিলেক্ট করুন।",
      "আমাদের রকেট নাম্বার 01912-345678 দিন।",
      "নির্দিষ্ট টাকার পরিমাণ লিখুন এবং পিন দিয়ে নিশ্চিত করুন।",
      "SMS-এ পাওয়া ট্রানজেকশন আইডি সংরক্ষণ করুন ও ফর্মে জমা দিন।",
    ],
  },
];

const faq = [
  {
    q: "পেমেন্ট করার পর কীভাবে এক্সেস বুঝে পাব?",
    a: "পেমেন্ট সফল হওয়ার পর আপনার প্রেরক নাম্বার ও Transaction ID (TrxID) চেকআউট ফর্মে সাবমিট করুন। আমাদের টিম ১০ থেকে ৩০ মিনিটের মধ্যে ভেরিফাই করে আপনার একাউন্ট ড্যাশবোর্ডে ও ইমেইলে ক্রেডেনশিয়ালস পাঠিয়ে দেবে।",
  },
  {
    q: "আমি কি অন্যের বিকাশ/নগদ একাউন্ট থেকে টাকা পাঠাতে পারব?",
    a: "হ্যাঁ, যেকোনো নাম্বার বা এজেন্ট থেকে সেন্ড মানি করতে পারবেন। শুধু চেকআউট ফর্মে 'Payment Number'-এর জায়গায় যে নাম্বার থেকে টাকা পাঠানো হয়েছে সেই নাম্বারটি এবং ফিরতি SMS-এর Transaction ID উল্লেখ করুন।",
  },
  {
    q: "ভুল পরিমাণ টাকা পাঠালে বা সমস্যা হলে কী করব?",
    a: "কোনো চিন্তা নেই! অবিলম্বে আমাদের WhatsApp হেল্পলাইন (+8801712-345678)-এ আপনার Order ID এবং পেমেন্টের স্ক্রিনশট পাঠান। আমাদের সাপোর্ট টিম দ্রুত অ্যাডজাস্ট বা অতিরিক্ত টাকা রিফান্ড করে দেবে।",
  },
  {
    q: "ভেরিফিকেশন হতে সাধারণত কত সময় লাগে?",
    a: "সকাল ১০:০০ টা থেকে রাত ১২:০০ টা পর্যন্ত সাধারণত ১০–৩০ মিনিটের মধ্যে সব পেমেন্ট ভেরিফাই হয়ে যায়। রাতে অর্ডার করলে সকালের শিফটে দ্রুত প্রসেস করা হয়।",
  },
  {
    q: "যদি পেমেন্ট রিজেক্ট হয় তাহলে রিফান্ড পাব?",
    a: "যদি কোনো কারণে পেমেন্ট ম্যাচ না করে বা আপনি অর্ডার বাতিল করতে চান, সম্পূর্ণ টাকা আপনার বিকাশ/নগদ নাম্বারে ফেরত দেওয়া হবে। ১০০% মানিব্যাক পলিসি সুরক্ষিত।",
  },
];
---

<ContentPage
  title="পেমেন্ট নির্দেশিকা — ghorebose.com"
  description="বিকাশ, নগদ ও রকেটের মাধ্যমে খুব সহজে এআই টুলস কেনার ধাপসমূহ এবং পেমেন্ট সংক্রান্ত বিস্তারিত সহায়িকা।"
  crumb="পেমেন্ট গাইড"
  narrow={false}
>
  <!-- Banner -->
  <div class="mb-10 rounded-[20px] border border-brand-200 bg-gradient-to-r from-brand-50 via-white to-brand-50 p-6 sm:p-8">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 px-3 py-1 text-xs font-bold text-accent font-bangla">
        🇧🇩 সহজ স্থানীয় পেমেন্ট
      </span>
      <h1 class="mt-3 font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-ink font-bangla">
        বিকাশ, নগদ ও রকেটে যেভাবে পেমেন্ট করবেন
      </h1>
      <p class="mt-2 text-sm text-muted-strong leading-relaxed font-bangla">
        আন্তর্জাতিক ডুয়াল কারেন্সি কার্ড ছাড়াই মাত্র ৩টি সহজ ধাপে বিকাশ, নগদ বা রকেটে সেন্ড মানি করে আপনার পছন্দের এআই টুলস সক্রিয় করে নিন।
      </p>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-3">
    {
      methods.map((m) => (
        <div class="rounded-[18px] border border-line bg-white p-6 shadow-xs hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class={`inline-flex h-11 w-11 items-center justify-center rounded-[12px] text-base font-extrabold ${m.badgeColor} shadow-xs`}>
                {m.name[0]}
              </span>
              <div>
                <h2 class="font-bangla text-base font-bold text-ink">{m.name}</h2>
                <p class="text-[11px] font-bangla text-muted">{m.type}</p>
              </div>
            </div>
          </div>

          <div class="mt-4 rounded-[14px] bg-surface-subtle p-4 border border-line/80">
            <p class="text-[11px] font-bold uppercase tracking-wider text-muted font-bangla">
              প্রাপক নাম্বার (Personal Number)
            </p>
            <p class="mt-1 font-display text-xl font-black tracking-tight text-ink">
              {m.number}
            </p>
          </div>

          <ol class="mt-5 space-y-2.5">
            {m.steps.map((s, i) => (
              <li class="flex items-start gap-2.5 text-xs text-muted-strong font-bangla leading-relaxed">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[11px] font-bold text-accent ring-1 ring-brand-200">
                  {i + 1}
                </span>
                <span>{s}</span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
    <div class="rounded-[20px] border border-line bg-white p-6 sm:p-8 shadow-xs">
      <h2 class="font-display text-xl font-extrabold tracking-tight text-ink font-bangla">
        পেমেন্ট ভেরিফিকেশন ও ডেলিভারি প্রক্রিয়া
      </h2>
      
      <div class="mt-5 space-y-4 font-bangla text-xs sm:text-sm text-muted-strong leading-relaxed">
        <p>
          <strong>১. পেমেন্ট সাবমিশন:</strong> বিকাশ, নগদ বা রকেটে সেন্ড মানি করার পর ট্রানজেকশন আইডি (TrxID) দিয়ে অর্ডার কনফার্ম করলে আপনার অর্ডার স্ট্যাটাস হবে <em>Payment Submitted</em>।
        </p>
        <p>
          <strong>২. অ্যাডমিন ভেরিফিকেশন:</strong> আমাদের অ্যাডমিন টিম আপনার ট্রানজেকশন আইডি এবং প্রেরক মোবাইল নাম্বার মিলিয়ে দেখে দ্রুত ভেরিফাই করে।
        </p>
        <p>
          <strong>৩. ড্যাশবোর্ডে এক্সেস ডেলিভারি:</strong> ভেরিফিকেশন সম্পন্ন হওয়া মাত্রই আপনার ড্যাশবোর্ডের <a href="/dashboard/purchased" class="text-accent font-bold underline">Purchased Tools</a> সেকশনে লগইন ক্রেডেনশিয়ালস বা অ্যাক্টিভেশন লিংক যুক্ত হয়ে যাবে এবং ইমেইলে নোটিফিকেশন পাঠানো হবে।
        </p>
      </div>

      <div class="mt-8 border-t border-line pt-6">
        <h3 class="font-bangla text-sm font-bold text-ink">অর্ডার স্ট্যাটাসের অর্থ:</h3>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 text-xs font-bangla">
          <div class="rounded-lg bg-surface-subtle p-2.5 border border-line">
            <span class="font-bold text-amber-700">Submitted</span>: পেমেন্ট তথ্য জমা হয়েছে, পর্যালোচনার অপেক্ষায়।
          </div>
          <div class="rounded-lg bg-surface-subtle p-2.5 border border-line">
            <span class="font-bold text-blue-700">Verified</span>: পেমেন্ট সফলভাবে নিশ্চিত হয়েছে।
          </div>
          <div class="rounded-lg bg-surface-subtle p-2.5 border border-line">
            <span class="font-bold text-emerald-700">Delivered</span>: আপনার এক্সেস সক্রিয় করা হয়েছে।
          </div>
          <div class="rounded-lg bg-surface-subtle p-2.5 border border-line">
            <span class="font-bold text-ink">Completed</span>: অর্ডার সফলভাবে সম্পন্ন হয়েছে।
          </div>
        </div>
      </div>
    </div>

    <div>
      <h2 class="font-display text-xl font-extrabold tracking-tight text-ink font-bangla">
        পেমেন্ট বিষয়ক প্রশ্নোত্তর (FAQ)
      </h2>
      <FaqAccordion faq={faq} class="mt-5" />

      <div class="mt-6 flex items-start gap-3 rounded-[16px] border border-emerald-200 bg-emerald-50 p-5">
        <Icon name="whatsapp" size={24} class="mt-0.5 shrink-0 text-emerald-600" />
        <div>
          <p class="text-xs sm:text-sm font-bold text-emerald-900 font-bangla">পেমেন্ট নিয়ে কোনো সমস্যায় পড়েছেন?</p>
          <p class="mt-1 text-xs leading-relaxed text-emerald-800/80 font-bangla">
            সরাসরি আপনার Order ID ও TrxID লিখে আমাদের WhatsApp নাম্বারে (01712-345678) মেসেজ দিন। আমাদের টিম তাৎক্ষণিক সমাধান দেবে।
          </p>
          <a
            href="https://wa.me/8801712345678"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-bold text-white transition-colors hover:bg-emerald-700"
          >
            <span>WhatsApp-এ সরাসরি কথা বলুন</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</ContentPage>
