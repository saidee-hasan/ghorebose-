---
import ContentPage from "@/layouts/ContentPage.astro";
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import FaqAccordion from "@/components/marketplace/FaqAccordion.astro";

const topics = [
  { icon: "cart", title: "টুলস কেনা ও অর্ডার নিয়ম", text: "পছন্দের এআই টুলস কীভাবে সিলেক্ট করবেন এবং ৩ ধাপে অর্ডার করবেন।", href: "/payment-help" },
  { icon: "credit-card", title: "বিকাশ ও নগদ পেমেন্ট", text: "bKash, Nagad ও Rocket দিয়ে সেন্ড মানি ও TrxID সাবমিট করার নিয়ম।", href: "/payment-help" },
  { icon: "package", title: "অর্ডার ট্র্যাকিং ও ডেলিভারি", text: "আপনার অর্ডার কখন ডেলিভারি হবে এবং স্ট্যাটাস কীভাবে ট্র্যাক করবেন।", href: "/dashboard/orders" },
  { icon: "key", title: "এক্সেস ও সাবস্ক্রিপশন", text: "লগইন ক্রেডেনশিয়ালস কোথায় পাবেন এবং কীভাবে ব্যবহার করবেন।", href: "/dashboard/purchased" },
  { icon: "refresh", title: "রিফান্ড ও রিটার্ন পলিসি", text: "পেমেন্ট সংক্রান্ত সমস্যা ও ১০০% মানিব্যাক গ্যারান্টির শর্তসমূহ।", href: "/refund-policy" },
  { icon: "shield", title: "একাউন্ট নিরাপত্তা ও ওয়ারেন্টি", text: "সম্পূর্ণ মেয়াদে রিপ্লেসমেন্ট সাপোর্ট ও ডাটা সুরক্ষা।", href: "/privacy" },
];

const faq = [
  { q: "আমি কীভাবে এআই টুলস কিনব?", a: "যে টুলসটি কিনতে চান সেটির পেজে গিয়ে প্ল্যান সিলেক্ট করে 'Buy Now' চাপুন। এরপর বিকাশ/নগদে নির্দিষ্ট টাকা সেন্ড মানি করে আপনার মোবাইল নম্বর ও TrxID দিন।" },
  { q: "ডেলিভারি পেতে কত সময় লাগে?", a: "আমাদের অ্যাডমিন টিম সাধারণত ১০ থেকে ৩০ মিনিটের মধ্যে অর্ডার ভেরিফাই করে আপনার ড্যাশবোর্ডে এবং ইমেইলে সার্ভিস অ্যাক্টিভ করে দেয়।" },
  { q: "আমার ক্রেডেনশিয়ালস বা লগইন তথ্য কোথায় পাব?", a: "পেমেন্ট ভেরিফাই হওয়ার পর Dashboard → Purchased Tools সেকশনে গেলেই আপনার নির্দিষ্ট টুলসের লগইন তথ্য, পাসওয়ার্ড বা ইনভাইট লিংক দেখতে পাবেন।" },
  { q: "পেমেন্ট করার পর পেন্ডিং দেখালে কী করব?", a: "পেমেন্ট সাবমিটের পর কিছুক্ষণ অপেক্ষা করুন। ৩০ মিনিটের বেশি হলে আপনার Order ID ও TrxID নিয়ে সরাসরি আমাদের WhatsApp নাম্বারে যোগাযোগ করুন।" },
  { q: "টুলসে কোনো সমস্যা হলে কি রিফান্ড পাব?", a: "হ্যাঁ! আপনার সাবস্ক্রিপশন মেয়াদের মধ্যে কোনো টেকনিক্যাল সমস্যা হলে আমরা দ্রুত সমাধান অথবা নতুন একাউন্ট রিপ্লেস করে দেব। সমাধান দিতে না পারলে সম্পূর্ণ রিফান্ড পাবেন।" },
  { q: "সাবস্ক্রিপশন মেয়াদ শেষ হলে রিনিউ করব কীভাবে?", a: "মেয়াদ শেষ হওয়ার আগেই Purchased Tools থেকে সরাসরি Renew বাটনে ক্লিক করে রিনিউয়াল করে নিতে পারবেন। কোনো ডাটা হারাবে না।" },
];
---

<ContentPage
  title="হেল্প সেন্টার (Help Center) — ghorebose.com"
  description="ghorebose.com থেকে এআই টুলস কেনা, বিকাশ-নগদ পেমেন্ট, ডেলিভারি ও সাপোর্ট সংক্রান্ত সকল নির্দেশিকা।"
  crumb="হেল্প সেন্টার"
  narrow={false}
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      topics.map((t) => (
        <a
          href={t.href}
          class="group flex flex-col rounded-[16px] border border-line bg-white p-5 shadow-xs transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md"
        >
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-[12px] bg-brand-50 text-accent transition-colors group-hover:bg-accent group-hover:text-white">
            <Icon name={t.icon} size={20} />
          </span>
          <h2 class="mt-4 font-bangla text-[15px] font-bold text-ink group-hover:text-accent">
            {t.title}
          </h2>
          <p class="mt-1.5 flex-1 font-bangla text-xs leading-relaxed text-muted">{t.text}</p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-muted font-bangla">
            বিস্তারিত দেখুন <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
      ))
    }
  </div>

  <section class="mt-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <span class="font-bangla text-xs font-bold uppercase tracking-wider text-accent bg-brand-50 px-2.5 py-1 rounded-full border border-brand-200">
          সাধারণ জিজ্ঞাসা
        </span>
        <h2 class="mt-3 font-display text-2xl font-extrabold tracking-tight text-ink font-bangla">
          সর্বাধিক জিজ্ঞাসিত প্রশ্ন ও উত্তর
        </h2>
        <p class="mt-2 text-xs sm:text-sm leading-relaxed text-muted font-bangla">
          আপনার সমস্যার দ্রুত সমাধানে নিচের প্রশ্ন-উত্তরগুলো দেখুন। আরও কোনো প্রশ্ন থাকলে আমাদের লাইভ সাপোর্ট সবসময় প্রস্তুত।
        </p>
        
        <div class="mt-6 flex flex-col gap-2.5">
          <Button href="https://wa.me/8801712345678" size="md" icon="whatsapp">
            WhatsApp এ সরাসরি কথা বলুন
          </Button>
          <Button href="/contact" size="md" variant="secondary" icon="mail">
            মেসেজ পাঠান
          </Button>
        </div>
      </div>
      <FaqAccordion faq={faq} />
    </div>
  </section>
</ContentPage>
