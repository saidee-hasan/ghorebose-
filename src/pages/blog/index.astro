---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import Icon from "@/components/ui/Icon.astro";
import Avatar from "@/components/ui/Avatar.astro";
import { blogPosts } from "@/data/blog";
import { formatDate } from "@/lib/format";
import { initials } from "@/lib/utils";

const [featured, ...rest] = blogPosts;
const tags = ["All", ...Array.from(new Set(blogPosts.map((p) => p.category)))];
---

<BaseLayout
  title="Blog"
  description="Guides, comparisons and payment tips for buying AI tools in Bangladesh."
>
  <Navbar active="blog" />

  <main id="main" class="flex-1">
    <div class="border-b border-line bg-surface-subtle">
      <div class="container-page py-10 sm:py-12">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Blog" }]} />
        <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
          Blog
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
          Guides, comparisons and practical advice on choosing and buying AI
          tools.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            tags.map((t, i) => (
              <span
                class:list={[
                  "rounded-full border px-3.5 py-1.5 text-[13px] font-semibold",
                  i === 0
                    ? "border-ink bg-ink text-white"
                    : "border-line bg-white text-muted-strong",
                ]}
              >
                {t}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="container-page py-10 sm:py-14">
      <!-- Featured -->
      <a
        href={`/blog/${featured.slug}`}
        class="group grid gap-6 overflow-hidden rounded-[20px] border border-line bg-white shadow-xs transition-all hover:border-line-strong hover:shadow-md lg:grid-cols-2"
      >
        <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
          <div class="flex items-center gap-3">
            <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-brand-700">
              {featured.category}
            </span>
            <span class="text-xs text-muted">{featured.readTime}</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-extrabold tracking-tight text-ink group-hover:text-accent sm:text-3xl">
            {featured.title}
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{featured.excerpt}</p>
          <div class="mt-5 flex items-center gap-3">
            <Avatar initials={initials(featured.author)} size="sm" />
            <div>
              <p class="text-[13px] font-semibold text-ink">{featured.author}</p>
              <p class="text-xs text-muted">{formatDate(featured.date)}</p>
            </div>
          </div>
        </div>
        <div class="relative hidden items-center justify-center bg-ink lg:flex">
          <div class="absolute inset-0 opacity-25" style="background-image:radial-gradient(circle at 30% 30%, #F97316 0, transparent 45%), radial-gradient(circle at 75% 70%, #F97316 0, transparent 40%);"></div>
          <Icon name="book-open" size={72} class="relative text-white/90" />
        </div>
      </a>

      <!-- Grid -->
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col rounded-[16px] border border-line bg-white p-6 shadow-xs transition-all hover:-translate-y-0.5 hover:border-line-strong hover:shadow-md"
            >
              <div class="flex items-center gap-3">
                <span class="rounded-full bg-surface-muted px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-muted-strong">
                  {post.category}
                </span>
                <span class="text-xs text-muted">{post.readTime}</span>
              </div>
              <h2 class="mt-4 font-display text-lg font-bold tracking-tight text-ink group-hover:text-accent">
                {post.title}
              </h2>
              <p class="mt-2 line-clamp-3 flex-1 text-[13px] leading-relaxed text-muted">
                {post.excerpt}
              </p>
              <div class="mt-5 flex items-center justify-between border-t border-line pt-4">
                <div class="flex items-center gap-2.5">
                  <Avatar initials={initials(post.author)} size="xs" />
                  <span class="text-xs font-semibold text-ink">{post.author}</span>
                </div>
                <span class="text-xs text-muted">{formatDate(post.date)}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
