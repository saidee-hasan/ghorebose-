---
import AdminLayout from "@/layouts/AdminLayout.astro";
import StatCard from "@/components/dashboard/StatCard.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import Button from "@/components/ui/Button.astro";
import { orders } from "@/data/orders";
import { customers } from "@/data/customers";
import { tools } from "@/data/tools";
import { formatBDT, formatDate } from "@/lib/format";

const totalSales = orders
  .filter((o) => o.status === "completed")
  .reduce((s, o) => s + o.amount, 0);
const pendingPayments = orders.filter(
  (o) => o.paymentStatus === "submitted",
).length;
const activeSubs = orders.filter(
  (o) => o.paymentStatus === "delivered" || o.paymentStatus === "completed",
).length;

const stats = [
  { label: "Total Sales", value: formatBDT(totalSales), icon: "dollar", trend: "+18.2%", accent: true },
  { label: "Total Orders", value: String(orders.length), icon: "package", trend: "+9.4%" },
  { label: "Pending Payments", value: String(pendingPayments), icon: "clock", hint: "Needs review today" },
  { label: "Active Users", value: String(customers.filter((c) => c.status === "active").length), icon: "users", trend: "+4.1%" },
  { label: "Active Subscriptions", value: String(activeSubs), icon: "refresh", trend: "+6.7%" },
  { label: "Total Tools", value: String(tools.length), icon: "layers", hint: `${tools.filter((t) => t.isFree).length} free · ${tools.filter((t) => !t.isFree).length} paid` },
];

// simple 7-day sales chart data
const sales = [3200, 4100, 2800, 5200, 6100, 4800, 7300];
const maxSale = Math.max(...sales);
const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

const pending = orders.filter((o) => o.paymentStatus === "submitted").slice(0, 5);
const recent = orders.slice(0, 6);

const topTools = [...tools]
  .sort((a, b) => b.popularity - a.popularity)
  .slice(0, 5);
---

<AdminLayout
  title="Admin Dashboard"
  active="dashboard"
  heading="Dashboard"
  description="Marketplace performance, payments awaiting review and recent activity."
>
  <Fragment slot="actions">
    <Button href="/admin/tools/new" icon="plus">Add Tool</Button>
  </Fragment>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {stats.map((s) => <StatCard {...s} />)}
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    <!-- Sales chart -->
    <section class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-base font-bold text-ink">Sales overview</h2>
          <p class="mt-0.5 text-xs text-muted">Last 7 days</p>
        </div>
        <div class="flex items-center gap-2 text-xs font-semibold text-muted">
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-sm bg-accent"></span> Revenue
          </span>
        </div>
      </div>
      <div class="mt-8 flex h-52 items-end gap-3">
        {
          sales.map((v, i) => (
            <div class="flex flex-1 flex-col items-center gap-2">
              <span class="text-[11px] font-semibold text-muted">
                {formatBDT(v)}
              </span>
              <div
                class="w-full rounded-t-[6px] bg-accent/85 transition-all hover:bg-accent"
                style={`height:${Math.round((v / maxSale) * 150)}px`}
              />
              <span class="text-[11px] font-medium text-muted">{days[i]}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Pending payments -->
    <section class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-base font-bold text-ink">Payments to review</h2>
        <a href="/admin/payments" class="text-xs font-semibold text-accent hover:text-accent-hover">
          View all
        </a>
      </div>
      <div class="mt-4 space-y-3">
        {
          pending.length === 0 ? (
            <p class="rounded-[12px] bg-surface-subtle p-4 text-sm text-muted">
              No payments waiting for review.
            </p>
          ) : (
            pending.map((o) => (
              <div class="flex items-center justify-between gap-3 rounded-[12px] border border-line p-3.5">
                <div class="min-w-0">
                  <p class="truncate text-[13px] font-semibold text-ink">
                    {o.toolName}
                  </p>
                  <p class="mt-0.5 font-mono text-[11px] text-muted">
                    {o.id} · {o.method} · {o.trxId}
                  </p>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-1.5">
                  <span class="text-[13px] font-bold text-ink">
                    {formatBDT(o.amount)}
                  </span>
                  <a
                    href={`/admin/orders/${o.id}`}
                    class="text-[11px] font-semibold text-accent hover:text-accent-hover"
                  >
                    Review
                  </a>
                </div>
              </div>
            ))
          )
        }
      </div>
      <div class="mt-4 rounded-[12px] border border-brand-200 bg-brand-50 p-4">
        <p class="text-[13px] font-medium text-brand-800">
          {pendingPayments} payment{pendingPayments === 1 ? "" : "s"} awaiting
          verification. Verify to deliver access automatically.
        </p>
      </div>
    </section>
  </div>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    <!-- Recent orders -->
    <section>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-ink">Recent orders</h2>
        <a href="/admin/orders" class="text-sm font-semibold text-accent hover:text-accent-hover">
          View all
        </a>
      </div>
      <div class="overflow-hidden rounded-[16px] border border-line bg-white shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[640px] text-left text-sm">
            <thead>
              <tr class="border-b border-line bg-surface-subtle text-[11px] font-bold uppercase tracking-[0.08em] text-muted">
                <th class="px-5 py-3.5">Order</th>
                <th class="px-5 py-3.5">Customer</th>
                <th class="px-5 py-3.5">Amount</th>
                <th class="px-5 py-3.5">Status</th>
                <th class="px-5 py-3.5">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {
                recent.map((o) => (
                  <tr class="transition-colors hover:bg-surface-subtle">
                    <td class="px-5 py-3.5">
                      <a
                        href={`/admin/orders/${o.id}`}
                        class="font-mono text-[13px] font-semibold text-ink hover:text-accent"
                      >
                        {o.id}
                      </a>
                      <p class="text-xs text-muted">{o.toolName}</p>
                    </td>
                    <td class="px-5 py-3.5 text-ink">{o.customer}</td>
                    <td class="px-5 py-3.5 font-semibold text-ink">
                      {formatBDT(o.amount)}
                    </td>
                    <td class="px-5 py-3.5">
                      <StatusBadge type="payment" status={o.paymentStatus} />
                    </td>
                    <td class="px-5 py-3.5 text-muted">{formatDate(o.createdAt)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Top tools -->
    <section class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
      <h2 class="font-display text-base font-bold text-ink">Top performing tools</h2>
      <div class="mt-4 space-y-3">
        {
          topTools.map((t, i) => (
            <div class="flex items-center gap-3">
              <span class="w-4 text-center text-xs font-bold text-muted">
                {i + 1}
              </span>
              <span
                class:list={[
                  "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] text-[11px] font-extrabold",
                  t.tone === "brand"
                    ? "bg-accent text-white"
                    : t.tone === "outline"
                      ? "border border-line-strong bg-white text-ink"
                      : "bg-ink text-white",
                ]}
              >
                {t.mark}
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-[13px] font-semibold text-ink">{t.name}</p>
                <p class="text-[11px] text-muted">{t.userCount} buyers</p>
              </div>
              <span class="shrink-0 text-[13px] font-bold text-ink">
                {formatBDT(t.price)}
              </span>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</AdminLayout>
