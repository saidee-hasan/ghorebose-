---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Rating from "@/components/ui/Rating.astro";
import Avatar from "@/components/ui/Avatar.astro";
import Button from "@/components/ui/Button.astro";
import { reviews } from "@/data/reviews";
import { getTool } from "@/data/tools";
import { formatDate } from "@/lib/format";

const list = reviews.slice(0, 12);
const avg = reviews.reduce((s, r) => s + r.rating, 0) / (reviews.length || 1);
---

<AdminLayout
  title="Reviews"
  active="reviews"
  heading="Reviews"
  description="Moderate customer reviews and keep listings trustworthy."
>
  <div class="mb-6 grid gap-4 sm:grid-cols-3">
    <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
      <p class="text-[13px] font-medium text-muted">Total reviews</p>
      <p class="mt-1 font-display text-2xl font-extrabold text-ink">{reviews.length}</p>
    </div>
    <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
      <p class="text-[13px] font-medium text-muted">Average rating</p>
      <p class="mt-1 font-display text-2xl font-extrabold text-ink">{avg.toFixed(1)}</p>
    </div>
    <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
      <p class="text-[13px] font-medium text-muted">Awaiting approval</p>
      <p class="mt-1 font-display text-2xl font-extrabold text-ink">
        {reviews.filter((r) => !r.verified).length}
      </p>
    </div>
  </div>

  <div class="space-y-4">
    {
      list.map((r) => {
        const tool = getTool(r.toolSlug);
        return (
          <article class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="flex items-center gap-3">
                <Avatar initials={r.initials} size="md" />
                <div>
                  <p class="flex items-center gap-2 text-sm font-bold text-ink">
                    {r.author}
                    {r.verified ? (
                      <span class="rounded-full border border-ink bg-ink px-2 py-0.5 text-[10px] font-bold text-white">
                        Verified
                      </span>
                    ) : (
                      <span class="rounded-full border border-brand-200 bg-brand-50 px-2 py-0.5 text-[10px] font-bold text-brand-700">
                        Pending
                      </span>
                    )}
                  </p>
                  <p class="text-xs text-muted">
                    on {tool?.name ?? r.toolSlug} · {formatDate(r.date)}
                  </p>
                </div>
              </div>
              <Rating rating={r.rating} size={14} />
            </div>
            <h3 class="mt-4 font-display text-[15px] font-bold text-ink">{r.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{r.body}</p>
            <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-line pt-4">
              <Button size="sm" variant="outline" icon="check">Approve</Button>
              <Button size="sm" variant="ghost" icon="x">Hide</Button>
              <Button size="sm" variant="ghost" icon="trash">Delete</Button>
              <span class="ml-auto text-xs text-muted">{r.helpful} found this helpful</span>
            </div>
          </article>
        );
      })
    }
  </div>
</AdminLayout>
