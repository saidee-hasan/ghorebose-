---
import AdminLayout from "@/layouts/AdminLayout.astro";
import OrderTimeline from "@/components/dashboard/OrderTimeline.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import AdminOrderActions from "@/components/admin/AdminOrderActions";
import CopyButton from "@/components/react/CopyButton";
import { orders, getOrder } from "@/data/orders";
import { getTool } from "@/data/tools";
import { formatBDT, formatDateTime } from "@/lib/format";

export function getStaticPaths() {
  return orders.map((order) => ({ params: { id: order.id } }));
}

const { id } = Astro.params;
const order = getOrder(id!)!;
const tool = getTool(order.toolSlug);
---

<AdminLayout
  title={`Order ${order.id}`}
  active="orders"
  heading={`Order ${order.id}`}
  description="Verify payment, deliver access and manage this order."
>
  <Fragment slot="actions">
    <Button href="/admin/orders" variant="outline" size="sm" icon="arrow-left">
      Back to orders
    </Button>
  </Fragment>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
    <div class="space-y-6">
      <!-- Summary -->
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex items-center gap-4">
            <span
              class:list={[
                "inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-[14px] font-display text-base font-extrabold",
                tool?.tone === "brand"
                  ? "bg-accent text-white"
                  : tool?.tone === "outline"
                    ? "border border-line-strong bg-white text-ink"
                    : "bg-ink text-white",
              ]}
            >
              {tool?.mark ?? "AI"}
            </span>
            <div>
              <h2 class="font-display text-lg font-bold text-ink">{order.toolName}</h2>
              <p class="text-sm text-muted">{order.plan} · {order.duration}</p>
            </div>
          </div>
          <div class="text-right">
            <p class="font-display text-2xl font-extrabold text-ink">{formatBDT(order.amount)}</p>
            <div class="mt-2 flex justify-end gap-2">
              <StatusBadge type="order" status={order.status} />
            </div>
          </div>
        </div>
      </div>

      <!-- Customer -->
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <h2 class="font-display text-base font-bold text-ink">Customer</h2>
        <div class="mt-4 flex items-center gap-4">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-ink text-sm font-bold text-white">
            {order.customer.split(" ").map((n) => n[0]).join("").slice(0, 2)}
          </span>
          <div>
            <p class="text-sm font-bold text-ink">{order.customer}</p>
            <p class="text-xs text-muted">{order.email}</p>
          </div>
          <a href="/admin/customers" class="ml-auto text-[13px] font-semibold text-accent hover:text-accent-hover">
            View customer
          </a>
        </div>
      </div>

      <!-- Payment details -->
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <h2 class="font-display text-base font-bold text-ink">Payment details</h2>
        <dl class="mt-4 grid gap-x-8 sm:grid-cols-2">
          {
            [
              { label: "Order ID", value: order.id, mono: true },
              { label: "Payment method", value: order.method },
              { label: "Transaction ID", value: order.trxId, mono: true },
              { label: "Amount", value: formatBDT(order.amount) },
              { label: "Submitted", value: formatDateTime(order.createdAt) },
              { label: "Expires", value: order.expiresAt },
            ].map((d) => (
              <div class="flex items-center justify-between gap-4 border-b border-line py-3">
                <dt class="text-sm text-muted">{d.label}</dt>
                <dd class:list={["text-sm font-semibold text-ink", d.mono && "font-mono"]}>
                  {d.value}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-5 flex flex-wrap items-center gap-3 rounded-[12px] border border-line bg-surface-subtle p-4">
          <div class="flex-1">
            <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
              Transaction ID
            </p>
            <p class="mt-0.5 font-mono text-sm font-semibold text-ink">{order.trxId}</p>
          </div>
          <CopyButton client:load value={order.trxId} label="Copy" />
        </div>
      </div>

      <!-- Timeline -->
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <h2 class="font-display text-base font-bold text-ink">Order timeline</h2>
        <OrderTimeline events={order.timeline} class="mt-5" />
      </div>
    </div>

    <aside class="space-y-4">
      <AdminOrderActions
        client:load
        orderId={order.id}
        initial={order.paymentStatus}
      />

      <div class="rounded-[16px] border border-line bg-surface-subtle p-5">
        <div class="flex items-start gap-3">
          <Icon name="info" size={18} class="mt-0.5 shrink-0 text-muted" />
          <p class="text-[13px] leading-relaxed text-muted">
            Verify the transaction ID against the merchant account before
            approving. If a payment cannot be verified, reject it to trigger an
            automatic refund.
          </p>
        </div>
      </div>
    </aside>
  </div>
</AdminLayout>
