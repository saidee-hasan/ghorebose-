---
import AdminLayout from "@/layouts/AdminLayout.astro";
import StatCard from "@/components/dashboard/StatCard.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import Button from "@/components/ui/Button.astro";
import CopyButton from "@/components/react/CopyButton";
import { orders } from "@/data/orders";
import { formatBDT, formatDateTime } from "@/lib/format";

const submitted = orders.filter((o) => o.paymentStatus === "submitted");
const verified = orders.filter((o) => o.paymentStatus === "verified" || o.paymentStatus === "delivered");
const rejected = orders.filter((o) => o.paymentStatus === "rejected");
const collected = orders
  .filter((o) => o.status === "completed")
  .reduce((s, o) => s + o.amount, 0);

const stats = [
  { label: "Collected", value: formatBDT(collected), icon: "wallet", accent: true },
  { label: "Awaiting verification", value: String(submitted.length), icon: "clock" },
  { label: "Verified / delivered", value: String(verified.length), icon: "check-circle" },
  { label: "Rejected", value: String(rejected.length), icon: "x-circle" },
];
---

<AdminLayout
  title="Payments"
  active="payments"
  heading="Payments"
  description="Verification queue and payment history across the marketplace."
>
  <Fragment slot="actions">
    <Button href="#" variant="outline" icon="download">Export</Button>
  </Fragment>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {stats.map((s) => <StatCard {...s} />)}
  </div>

  <!-- Verification queue -->
  <section class="mt-6">
    <div class="mb-4 flex items-center gap-3">
      <h2 class="font-display text-lg font-bold text-ink">Verification queue</h2>
      <span class="rounded-full bg-accent px-2.5 py-0.5 text-[11px] font-bold text-white">
        {submitted.length}
      </span>
    </div>
    {
      submitted.length === 0 ? (
        <div class="rounded-[16px] border border-dashed border-line bg-surface-subtle px-6 py-12 text-center">
          <p class="text-sm font-semibold text-ink">Queue is clear</p>
          <p class="mt-1 text-sm text-muted">No payments are waiting for verification.</p>
        </div>
      ) : (
        <div class="grid gap-4 lg:grid-cols-2">
          {submitted.map((o) => (
            <div class="rounded-[16px] border border-brand-200 bg-brand-50 p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="font-mono text-[13px] font-bold text-ink">{o.id}</p>
                  <p class="mt-1 text-sm font-semibold text-ink">{o.toolName}</p>
                  <p class="text-xs text-brand-800/70">{o.customer} · {o.email}</p>
                </div>
                <span class="font-display text-lg font-extrabold text-ink">
                  {formatBDT(o.amount)}
                </span>
              </div>
              <div class="mt-4 flex items-center gap-3 rounded-[12px] border border-brand-200 bg-white p-3">
                <div class="flex-1">
                  <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
                    {o.method} · Transaction ID
                  </p>
                  <p class="mt-0.5 font-mono text-sm font-semibold text-ink">{o.trxId}</p>
                </div>
                <CopyButton client:load value={o.trxId} label="Copy" />
              </div>
              <div class="mt-4 flex gap-2.5">
                <Button href={`/admin/orders/${o.id}`} size="sm" class="flex-1">
                  Review & verify
                </Button>
                <Button href={`/admin/orders/${o.id}`} variant="outline" size="sm">
                  Details
                </Button>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <!-- All payments -->
  <section class="mt-8">
    <h2 class="mb-4 font-display text-lg font-bold text-ink">All payments</h2>
    <div class="overflow-hidden rounded-[16px] border border-line bg-white shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[860px] text-left text-sm">
          <thead>
            <tr class="border-b border-line bg-surface-subtle text-[11px] font-bold uppercase tracking-[0.08em] text-muted">
              <th class="px-5 py-3.5">Order</th>
              <th class="px-5 py-3.5">Customer</th>
              <th class="px-5 py-3.5">Method</th>
              <th class="px-5 py-3.5">Transaction ID</th>
              <th class="px-5 py-3.5">Amount</th>
              <th class="px-5 py-3.5">Date</th>
              <th class="px-5 py-3.5">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              orders.map((o) => (
                <tr class="transition-colors hover:bg-surface-subtle">
                  <td class="px-5 py-4">
                    <a href={`/admin/orders/${o.id}`} class="font-mono text-[13px] font-semibold text-ink hover:text-accent">
                      {o.id}
                    </a>
                  </td>
                  <td class="px-5 py-4 text-ink">{o.customer}</td>
                  <td class="px-5 py-4 text-muted">{o.method}</td>
                  <td class="px-5 py-4 font-mono text-xs text-muted">{o.trxId}</td>
                  <td class="px-5 py-4 font-semibold text-ink">{formatBDT(o.amount)}</td>
                  <td class="px-5 py-4 text-muted">{formatDateTime(o.createdAt)}</td>
                  <td class="px-5 py-4">
                    <StatusBadge type="payment" status={o.paymentStatus} />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</AdminLayout>
