---
import AuthLayout from "@/layouts/AuthLayout.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import PasswordField from "@/components/react/PasswordField";
---

<AuthLayout
  title="Reset password"
  heading="Set a new password"
  subtitle="Choose a strong password you haven't used before."
>
  <form class="space-y-5" onsubmit="event.preventDefault();">
    <PasswordField
      client:load
      label="New password"
      name="password"
      autocomplete="new-password"
      showStrength
    />
    <PasswordField
      client:load
      label="Confirm new password"
      name="confirmPassword"
      autocomplete="new-password"
    />

    <ul class="space-y-2 rounded-[12px] border border-line bg-surface-subtle p-4">
      {
        [
          "At least 8 characters long",
          "Contains a number and a symbol",
          "Different from your previous password",
        ].map((r) => (
          <li class="flex items-start gap-2.5 text-[13px] text-muted-strong">
            <Icon name="check" size={14} class="mt-0.5 shrink-0 text-accent" />
            {r}
          </li>
        ))
      }
    </ul>

    <Button type="submit" size="lg" block>Reset password</Button>
  </form>

  <p class="mt-8 text-center text-sm text-muted">
    <a href="/login" class="font-semibold text-accent hover:text-accent-hover">
      Back to login
    </a>
  </p>
</AuthLayout>
