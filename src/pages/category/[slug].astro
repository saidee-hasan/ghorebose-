---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import ToolsExplorer from "@/components/react/ToolsExplorer";
import { categories, getCategory } from "@/data/categories";
import { tools } from "@/data/tools";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug } }));
}

const { slug } = Astro.params;
const category = getCategory(slug!)!;
const catTools = tools.filter((t) => t.category === slug);
const cats = categories.map((c) => ({ slug: c.slug, name: c.name }));

const siblings = categories
  .filter((c) => c.slug !== slug && c.group === category.group)
  .slice(0, 6);
---

<BaseLayout
  title={`${category.name} Tools`}
  description={`${category.description} Compare pricing, ratings and features, and buy ${category.name} access on ghorebose.com.`}
  canonical={`/category/${category.slug}`}
>
  <Navbar active="tools" />

  <main id="main" class="flex-1">
    <div class="border-b border-line bg-surface-subtle">
      <div class="container-page py-8 sm:py-10">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "All Tools", href: "/tools" },
            { label: category.name },
          ]}
        />
        <div class="mt-5 flex flex-wrap items-start justify-between gap-6">
          <div class="flex items-start gap-4">
            <span
              class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-[16px] border border-line bg-white text-accent"
            >
              <Icon name={category.icon} size={26} />
            </span>
            <div>
              <h1
                class="font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
              >
                {category.name}
              </h1>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
                {category.description}
              </p>
              <p class="mt-3 flex items-center gap-2 text-xs font-semibold text-muted">
                <Icon name="layers" size={14} />
                {catTools.length} tools in this category
              </p>
            </div>
          </div>
          <Button href="/tools" variant="outline" size="sm" icon="grid">
            All categories
          </Button>
        </div>
      </div>
    </div>

    <div class="container-page py-8 sm:py-10">
      <ToolsExplorer
        client:load
        tools={catTools as any}
        categories={cats}
        initialCategory={category.slug}
        lockCategory
      />

      <!-- SEO copy -->
      <section class="mt-14 border-t border-line pt-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_320px]">
          <div class="max-w-3xl">
            <h2 class="font-display text-xl font-extrabold tracking-tight text-ink">
              About {category.name} tools
            </h2>
            <div class="mt-4 space-y-4 text-sm leading-relaxed text-muted">
              <p>
                {category.description} On ghorebose.com you can compare plans,
                read verified reviews and buy access with local payment methods
                in minutes.
              </p>
              <p>
                Every {category.name.toLowerCase()} tool listed here is reviewed
                by our team before it goes live. Pricing is shown upfront, and
                delivery happens through your dashboard once payment is
                verified — usually within 30 minutes.
              </p>
              <p>
                Not sure which plan to choose? Start with the most popular tool
                in this category, or message our support team for a
                recommendation based on your use case.
              </p>
            </div>
          </div>

          <aside class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-[0.14em] text-ink">
              Related categories
            </h3>
            <ul class="mt-4 space-y-1">
              {
                siblings.map((c) => (
                  <li>
                    <a
                      href={`/category/${c.slug}`}
                      class="flex items-center justify-between gap-3 rounded-[10px] px-3 py-2.5 text-sm font-medium text-muted-strong transition-colors hover:bg-surface-subtle hover:text-ink"
                    >
                      <span class="flex items-center gap-2.5">
                        <Icon name={c.icon} size={16} />
                        {c.name}
                      </span>
                      <Icon name="chevron-right" size={15} />
                    </a>
                  </li>
                ))
              }
            </ul>
          </aside>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
