---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import Icon from "@/components/ui/Icon.astro";
import Rating from "@/components/ui/Rating.astro";
import { tools } from "@/data/tools";
import { categories } from "@/data/categories";
import { formatBDT } from "@/lib/format";

// Top best selling tools for BD users
const topBdTools = tools
  .filter((t) => ["chatgpt-plus", "claude-pro", "midjourney", "canva-pro", "cursor-pro", "perplexity-pro", "elevenlabs", "capcut-pro"].includes(t.slug))
  .slice(0, 8);

const bnCategoryMap: Record<string, { bnName: string; bnDesc: string; icon: string }> = {
  "ai-chat-assistant": { bnName: "চ্যাট ও এআই অ্যাসিস্ট্যান্ট", bnDesc: "ChatGPT, Claude, Gemini", icon: "chat" },
  "ai-writing": { bnName: "রাইটিং ও কপিরাইটিং", bnDesc: "ব্লগ, স্ক্রিপ্ট ও কন্টেন্ট এআই", icon: "pen" },
  "ai-image": { bnName: "এআই ইমেজ ও আর্ট", bnDesc: "Midjourney, DALL-E 3", icon: "image" },
  "ai-video": { bnName: "ভিডিও ও অ্যানিমেশন", bnDesc: "AI ভিডিও এডিটিং ও মেকিং", icon: "video" },
  "ai-coding": { bnName: "কোডিং ও ডেভেলপমেন্ট", bnDesc: "Cursor, GitHub Copilot", icon: "code" },
  "ai-design": { bnName: "ডিজাইন ও গ্রাফিক্স", bnDesc: "Canva Pro, UI/UX টুলস", icon: "palette" },
  "ai-voice": { bnName: "ভয়েসওভার ও অডিও", bnDesc: "ElevenLabs, টেক্সট-টু-স্পিচ", icon: "mic" },
  "ai-productivity": { bnName: "প্রোডাক্টিভিটি ও নোটস", bnDesc: "Notion AI, পার্সোনাল কপাইলট", icon: "bolt" },
};

const topCategories = categories.filter((c) => bnCategoryMap[c.slug]).slice(0, 8);

const testimonials = [
  {
    name: "তানভীর আহমেদ",
    role: "Full-Stack Developer",
    location: "মিরপুর, ঢাকা",
    tool: "Cursor AI & Claude Pro",
    rating: 5,
    text: "ডুয়াল কারেন্সি কার্ড না থাকায় অনেকদিন ধরে Claude Pro আর Cursor AI কিনতে পারছিলাম না। ghorebose.com থেকে বিকাশে পেমেন্ট করার মাত্র ১৫ মিনিটেই একটিভেশন পেয়েছি। অসাধারণ সার্ভিস!",
  },
  {
    name: "নুসরাত জাহান",
    role: "UI/UX & Graphic Designer",
    location: "জিইসি, চট্টগ্রাম",
    tool: "Midjourney & Canva Pro",
    rating: 5,
    text: "ডিজাইনারদের জন্য Canva Pro এবং Midjourney লাইফসেভার। কম খরচে অরিজিনাল লাইসেন্স পেয়েছি এবং সাপোর্ট টিমের ব্যবহার খুবই আন্তরিক।",
  },
  {
    name: "রাকিব হাসান",
    role: "Freelance SEO & Content Specialist",
    location: "সিলেট সদর",
    tool: "ChatGPT Plus & Perplexity Pro",
    rating: 5,
    text: "ফ্রিল্যান্সিংয়ে প্রতিনিয়ত ChatGPT Plus লাগে। এখানে মাসিক রিনিউয়াল কোনো ঝামেলা ছাড়াই করা যায়। ১০০% ট্রাস্টেড ও নির্ভরযোগ্য।",
  },
  {
    name: "সাদিয়া ইসলাম",
    role: "Computer Science Student, DU",
    location: "ধানমন্ডি, ঢাকা",
    tool: "GitHub Copilot & Notion AI",
    rating: 5,
    text: "স্টুডেন্টদের জন্য প্রিমিয়াম AI টুলস কেনা অনেক ব্যয়বহুল ছিল। ghorebose-এর সাশ্রয়ী দাম এবং নগদ পেমেন্ট অপশন দারুণ কাজে দিয়েছে।",
  },
];

const faqs = [
  {
    q: "বিকাশ বা নগদ দিয়ে কীভাবে AI টুলস অর্ডার করব?",
    a: "আপনার পছন্দের টুলস সিলেক্ট করে 'Buy Now' ক্লিক করুন। এরপর সাবস্ক্রিপশন প্ল্যান বাছাই করে বিকাশ, নগদ বা রকেটে আমাদের পার্সোনাল নাম্বারে সেন্ড মানি করুন। পেমেন্ট শেষ হলে TrxID ও আপনার নাম্বার সাবমিট করলেই অর্ডার কনফার্ম হবে।",
  },
  {
    q: "পেমেন্ট করার কতক্ষণ পর আমি এক্সেস পাব?",
    a: "আমাদের অ্যাডমিন টিম পেমেন্ট ভেরিফাই করার সাথে সাথেই (সাধারণত ১০ থেকে ৩০ মিনিটের মধ্যে) আপনার ড্যাশবোর্ডে এবং ইমেইলে ফুল এক্সেস ক্রেডেনশিয়ালস বা অ্যাক্টিভেশন লিংক পাঠিয়ে দেওয়া হয়।",
  },
  {
    q: "আমার কি আন্তর্জাতিক ডুয়াল কারেন্সি বা ক্রেডিট কার্ড লাগবে?",
    a: "একদমই না! ghorebose.com তৈরিই করা হয়েছে যাতে বাংলাদেশের যে কেউ কোনো ভিসা/মাস্টারকার্ড বা পাসপোর্ট এনডোর্সমেন্ট ছাড়াই শুধু বিকাশ, নগদ বা রকেট দিয়ে আন্তর্জাতিক এআই টুলস কিনতে পারেন।",
  },
  {
    q: "অ্যাকাউন্টে কোনো সমস্যা হলে কি রিপ্লেসমেন্ট ওয়ারেন্টি পাব?",
    a: "হ্যাঁ, আপনার সাবস্ক্রিপশনের সম্পূর্ণ মেয়াদের জন্য আমাদের ১০০% ফুল রিপ্লেসমেন্ট গ্যারান্টি রয়েছে। কোনো টেকনিক্যাল ইস্যু হলে আমাদের WhatsApp হেল্পলাইনে জানালেই দ্রুত সমাধান বা নতুন অ্যাকাউন্ট দেওয়া হবে।",
  },
  {
    q: "এগুলো কি অফিসিয়াল ও নিরাপদ অ্যাকাউন্ট?",
    a: "হ্যাঁ, আমরা শুধুমাত্র ভেরিফাইড এবং সেফ অফিসিয়াল অ্যাকাউন্ট সরবরাহ করি। কোনো ক্র্যাক বা অবৈধ মেথড ব্যবহার করা হয় না, ফলে আপনার কাজের ডাটা সম্পূর্ণ সুরক্ষিত থাকে।",
  },
];
---

<BaseLayout
  title="ghorebose.com — ঘরে বসেই বিকাশ ও নগদে কিনুন প্রিমিয়াম এআই টুলস"
  description="বাংলাদেশের ১ নম্বর এআই মার্কেটপ্লেস। আন্তর্জাতিক কার্ড ছাড়াই বিকাশ, নগদ ও রকেটে কিনুন ChatGPT Plus, Claude Pro, Midjourney, Canva Pro ও ১০০+ সেরা AI Tools।"
>
  <Navbar />

  <main id="main" class="flex-1">
    <!-- ======================== 1. HERO SECTION ======================== -->
    <section class="relative overflow-hidden border-b border-line bg-gradient-to-b from-brand-50/50 via-white to-white py-14 sm:py-20">
      <!-- Decorative background blur circles -->
      <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-96 w-[45rem] rounded-full bg-brand-100/40 blur-3xl" aria-hidden="true"></div>

      <div class="container-page relative">
        <div class="mx-auto max-w-3xl text-center">
          <!-- Main Catchy Bilingual Headline (Exact 2 lines on mobile) -->
          <h1 class="font-display text-[23px] min-[380px]:text-[26px] sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-[1.3] sm:leading-[1.25]">
            <span class="block">ঘরে বসেই কিনুন বিশ্বের সেরা সব</span>
            <span class="block text-accent">প্রিমিয়াম AI Tools</span>
          </h1>

          <!-- Value Proposition Subtitle -->
          <p class="mt-5 text-base sm:text-lg leading-relaxed text-muted font-bangla max-w-2xl mx-auto">
            কোনো আন্তর্জাতিক কার্ড ছাড়াই বিকাশ ও নগদে কিনুন ChatGPT Plus, Midjourney, Claude Pro, Canva Pro সহ সকল সেরা AI সাবস্ক্রিপশন।
          </p>

          <!-- Action Buttons -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
            <a
              href="/tools"
              class="inline-flex h-12 items-center justify-center gap-2 rounded-[12px] bg-accent px-6 text-sm sm:text-base font-bold text-white shadow-md transition-all duration-200 hover:bg-accent-hover hover:shadow-lg hover:-translate-y-0.5"
            >
              <Icon name="cart" size={18} />
              <span>টুলস ব্রাউজ করুন</span>
            </a>

            <a
              href="https://wa.me/8801712345678?text=%E0%A6%86%E0%A6%B8%E0%A6%B8%E0%A6%BE%E0%A6%B2%E0%A6%BE%E0%A6%AE%E0%A7%81%20%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%81%E0%A6%AE!%20%E0%A6%8F%E0%A6%86%E0%A6%87%20%E0%A6%9F%E0%A7%81%E0%A6%B2%E0%A6%B8%20%E0%A6%95%E0%A6%BF%E0%A6%A8%E0%A6%A4%E0%A7%87%20%E0%A6%9A%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A6%BF%E0%A5%A4"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-12 items-center justify-center gap-2 rounded-[12px] border border-emerald-300 bg-white px-5 text-sm sm:text-base font-bold text-emerald-700 shadow-xs transition-all duration-200 hover:bg-emerald-50 hover:border-emerald-400"
            >
              <Icon name="whatsapp" size={18} class="text-emerald-600" />
              <span>WhatsApp-এ অর্ডার দিন</span>
            </a>
          </div>

          <!-- Popular Search Tags for BD Users -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-2 text-sm">
            <span class="font-bangla font-semibold text-muted text-xs sm:text-sm">জনপ্রিয়:</span>
            {["ChatGPT Plus", "Claude Pro", "Midjourney", "Canva Pro", "Cursor AI", "CapCut Pro"].map((tag) => (
              <a
                href={`/tools?q=${encodeURIComponent(tag)}`}
                class="rounded-full border border-line bg-white px-3 py-1 text-xs sm:text-sm text-muted-strong transition-colors hover:border-accent hover:text-accent font-medium shadow-xs"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ======================== 2. TOP TRENDING / BEST-SELLING TOOLS ======================== -->
    <section class="section border-b border-line bg-white">
      <div class="container-page">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <div class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-700 border border-brand-200">
              <Icon name="flame" size={14} />
              <span class="font-bangla">সেরা পছন্দের টুলস</span>
            </div>
            <h2 class="mt-2 font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
              বাংলাদেশে সবচেয়ে জনপ্রিয় এআই টুলস
            </h2>
            <p class="mt-1 text-sm sm:text-base text-muted font-bangla">
              ফ্রিল্যান্সার, কন্টেন্ট ক্রিয়েটর, ডেভেলপার ও শিক্ষার্থীদের পছন্দের টপ রেটেড সাবস্ক্রিপশন
            </p>
          </div>
          <a
            href="/tools?sort=popular"
            class="inline-flex items-center gap-1 text-sm font-bold text-accent hover:text-accent-hover transition-colors font-bangla"
          >
            <span>সব সেরা টুলস দেখুন</span>
            <Icon name="chevron-right" size={16} />
          </a>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
          {topBdTools.map((t) => {
            const discount = t.compareAtPrice
              ? Math.round((1 - t.price / t.compareAtPrice) * 100)
              : 0;
            return (
              <div class="group flex flex-col overflow-hidden rounded-[14px] sm:rounded-[18px] border border-line bg-white shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-line-strong hover:shadow-lg">
                <a href={`/tools/${t.slug}`} class="relative block aspect-[16/11] overflow-hidden bg-surface-subtle">
                  <img
                    src={`/covers/${t.slug}.svg`}
                    alt={t.name}
                    width="800"
                    height="500"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                  <div class="absolute left-2 sm:left-3 top-2 sm:top-3 flex flex-col gap-1 sm:gap-1.5">
                    {t.isFree ? (
                      <span class="rounded-full bg-accent px-2 sm:px-2.5 py-0.5 text-[9px] sm:text-xs font-bold text-white shadow-sm uppercase">Free</span>
                    ) : discount > 0 ? (
                      <span class="rounded-full bg-ink px-2 sm:px-2.5 py-0.5 text-[9px] sm:text-xs font-bold text-white shadow-sm">−{discount}%</span>
                    ) : null}
                  </div>
                  <div class="absolute right-2 sm:right-3 top-2 sm:top-3">
                    <span class="inline-flex items-center gap-1 rounded-full bg-white/95 px-2 py-0.5 text-[9px] sm:text-[10px] font-bold text-emerald-800 shadow-xs backdrop-blur font-bangla">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      স্টক: {t.stock || 15}
                    </span>
                  </div>
                </a>

                <div class="flex flex-1 flex-col p-3 sm:p-4">
                  <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-accent truncate">
                      {t.category.replace("ai-", "").replace("-", " ")}
                    </span>
                    <Rating rating={t.rating} size={12} showValue />
                  </div>

                  <h3 class="mt-1.5 font-display text-xs sm:text-[16px] font-extrabold text-ink group-hover:text-accent transition-colors truncate">
                    <a href={`/tools/${t.slug}`}>{t.name}</a>
                  </h3>

                  <div class="mt-2.5 flex items-baseline justify-between border-t border-line pt-2">
                    <div>
                      <span class="font-display text-sm sm:text-xl font-extrabold text-accent">
                        {t.isFree ? "Free" : formatBDT(t.price)}
                      </span>
                      {!t.isFree && <span class="text-[10px] sm:text-xs text-muted">/{t.duration || "Month"}</span>}
                    </div>
                    {t.compareAtPrice && (
                      <span class="text-[10px] sm:text-xs text-muted line-through">{formatBDT(t.compareAtPrice)}</span>
                    )}
                  </div>

                  <div class="mt-3 grid grid-cols-2 gap-1.5 sm:gap-2">
                    <a
                      href={`/tools/${t.slug}`}
                      class="inline-flex h-8 sm:h-9 items-center justify-center rounded-[8px] sm:rounded-[10px] border border-line bg-white text-[11px] sm:text-xs font-semibold text-ink transition-colors hover:bg-surface-subtle"
                    >
                      Details
                    </a>
                    <a
                      href={`/checkout/${t.slug}`}
                      class="inline-flex h-8 sm:h-9 items-center justify-center gap-1 rounded-[8px] sm:rounded-[10px] bg-accent text-[11px] sm:text-xs font-bold text-white transition-colors hover:bg-accent-hover shadow-xs"
                    >
                      <span>Buy Now</span>
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ======================== 3. POPULAR CATEGORIES ======================== -->
    <section class="section border-b border-line bg-surface-subtle">
      <div class="container-page">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="inline-block font-bangla text-xs font-bold uppercase tracking-wider text-accent bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
            ক্যাটাগরি সমূহ
          </span>
          <h2 class="mt-3 font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
            আপনার প্রয়োজনীয় কাজের ক্যাটাগরি বেছে নিন
          </h2>
          <p class="mt-2 text-sm sm:text-base text-muted font-bangla">
            কন্টেন্ট লেখা, ছবি ও ভিডিও তৈরি, প্রোগ্রামিং থেকে শুরু করে সব ধরণের কাজের জন্য ডেডিকেটেড এআই টুলস
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {topCategories.map((c) => {
            const meta = bnCategoryMap[c.slug];
            return (
              <a
                href={`/category/${c.slug}`}
                class="group flex items-start gap-3.5 rounded-[16px] border border-line bg-white p-4 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
              >
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[12px] bg-brand-50 text-accent transition-colors group-hover:bg-accent group-hover:text-white">
                  <Icon name={meta?.icon || c.icon} size={22} />
                </span>
                <div class="min-w-0">
                  <h3 class="font-bangla font-bold text-sm sm:text-base text-ink group-hover:text-accent transition-colors">
                    {meta?.bnName || c.name}
                  </h3>
                  <p class="mt-0.5 text-xs text-muted truncate">{c.name}</p>
                  <p class="mt-1 font-bangla text-xs text-muted-strong line-clamp-1">{meta?.bnDesc}</p>
                </div>
              </a>
            );
          })}
        </div>

        <div class="mt-8 text-center">
          <a
            href="/tools"
