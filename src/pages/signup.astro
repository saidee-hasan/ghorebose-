---
import AuthLayout from "@/layouts/AuthLayout.astro";
import Input from "@/components/ui/Input.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import PasswordField from "@/components/react/PasswordField";
---

<AuthLayout
  title="Create account"
  heading="Create your account"
  subtitle="Start buying premium AI tools in minutes. It's free to join."
>
  <form class="space-y-5" onsubmit="event.preventDefault();">
    <Input
      label="Full name"
      name="name"
      placeholder="Your full name"
      icon="user"
      autocomplete="name"
      required
    />
    <Input
      label="Email"
      name="email"
      type="email"
      placeholder="you@example.com"
      icon="mail"
      autocomplete="email"
      required
    />
    <PasswordField
      client:load
      label="Password"
      name="password"
      autocomplete="new-password"
      showStrength
    />
    <PasswordField
      client:load
      label="Confirm password"
      name="confirmPassword"
      autocomplete="new-password"
    />

    <label class="flex cursor-pointer items-start gap-3 text-[13px] leading-relaxed text-muted-strong">
      <input type="checkbox" required class="mt-0.5 h-4 w-4 accent-accent" />
      <span>
        I agree to the
        <a href="/terms" class="font-semibold text-accent hover:text-accent-hover">Terms</a>
        and
        <a href="/privacy" class="font-semibold text-accent hover:text-accent-hover">Privacy Policy</a>.
      </span>
    </label>

    <Button type="submit" size="lg" block>Create account</Button>
  </form>

  <div class="my-6 flex items-center gap-4">
    <span class="h-px flex-1 bg-line"></span>
    <span class="text-xs font-medium text-muted">or sign up with</span>
    <span class="h-px flex-1 bg-line"></span>
  </div>

  <button
    type="button"
    class="inline-flex h-12 w-full items-center justify-center gap-3 rounded-[10px] border border-line bg-white text-sm font-semibold text-ink transition-colors hover:bg-surface-subtle"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M23.5 12.27c0-.79-.07-1.54-.2-2.27H12v4.51h6.47a5.53 5.53 0 0 1-2.4 3.63v3h3.88c2.27-2.09 3.55-5.17 3.55-8.87Z" />
      <path fill="#34A853" d="M12 24c3.24 0 5.96-1.08 7.95-2.91l-3.88-3a7.2 7.2 0 0 1-10.7-3.78H1.35v3.09A12 12 0 0 0 12 24Z" />
      <path fill="#FBBC05" d="M5.37 14.31a7.2 7.2 0 0 1 0-4.62V6.6H1.35a12 12 0 0 0 0 10.8l4.02-3.09Z" />
      <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.35 6.6l4.02 3.09A7.2 7.2 0 0 1 12 4.75Z" />
    </svg>
    Sign up with Google
  </button>

  <p class="mt-8 text-center text-sm text-muted">
    Already have an account?
    <a href="/login" class="font-semibold text-accent hover:text-accent-hover">Login</a>
  </p>

  <div class="mt-6 flex items-start gap-2.5 rounded-[12px] border border-line bg-surface-subtle p-4">
    <Icon name="shield" size={16} class="mt-0.5 shrink-0 text-accent" />
    <p class="text-xs leading-relaxed text-muted">
      Your data is encrypted and never shared with third parties.
    </p>
  </div>
</AuthLayout>
