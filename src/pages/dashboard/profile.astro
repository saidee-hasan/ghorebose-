---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Input from "@/components/ui/Input.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Avatar from "@/components/ui/Avatar.astro";
import PasswordField from "@/components/react/PasswordField";
import { currentUser } from "@/data/orders";
import { formatDate } from "@/lib/format";
---

<DashboardLayout
  title="Profile"
  active="profile"
  heading="Profile"
  description="Manage your personal information and account password."
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-6">
      <!-- Personal info -->
      <section class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <h2 class="font-display text-base font-bold text-ink">Personal information</h2>
        <form class="mt-5 space-y-5" onsubmit="event.preventDefault();">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
            <Avatar initials={currentUser.initials} size="xl" variant="ink" />
            <div>
              <p class="text-sm font-bold text-ink">Profile photo</p>
              <p class="mt-0.5 text-xs text-muted">PNG or JPG, up to 2MB.</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <Button type="button" variant="outline" size="sm" icon="upload">
                  Upload new
                </Button>
                <Button type="button" variant="ghost" size="sm">Remove</Button>
              </div>
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <Input
              label="Full name"
              name="name"
              value={currentUser.name}
              icon="user"
              required
            />
            <Input
              label="Email"
              name="email"
              type="email"
              value={currentUser.email}
              icon="mail"
              required
            />
          </div>
          <Input
            label="Phone"
            name="phone"
            value={currentUser.phone}
            icon="phone"
          />
          <div class="flex flex-wrap gap-3 border-t border-line pt-5">
            <Button type="submit" icon="check">Save Changes</Button>
            <Button type="reset" variant="ghost">Discard</Button>
          </div>
        </form>
      </section>

      <!-- Password -->
      <section class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <h2 class="font-display text-base font-bold text-ink">Change password</h2>
        <p class="mt-1 text-sm text-muted">
          Use a strong password you don't use anywhere else.
        </p>
        <form class="mt-5 space-y-5" onsubmit="event.preventDefault();">
          <PasswordField
            client:load
            label="Current password"
            name="currentPassword"
            autocomplete="current-password"
          />
          <div class="grid gap-5 sm:grid-cols-2">
            <PasswordField
              client:load
              label="New password"
              name="newPassword"
              autocomplete="new-password"
              showStrength
            />
            <PasswordField
              client:load
              label="Confirm new password"
              name="confirmPassword"
              autocomplete="new-password"
            />
          </div>
          <div class="border-t border-line pt-5">
            <Button type="submit" icon="lock">Change Password</Button>
          </div>
        </form>
      </section>
    </div>

    <aside class="space-y-4">
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
        <h2 class="font-display text-base font-bold text-ink">Account</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-muted">Member since</dt>
            <dd class="font-semibold text-ink">{formatDate(currentUser.joined)}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted">Account type</dt>
            <dd class="font-semibold text-ink">Plus member</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted">Status</dt>
            <dd class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-ink">
              <span class="h-1.5 w-1.5 rounded-full bg-accent"></span> Active
            </dd>
          </div>
        </dl>
      </div>

      <div class="rounded-[16px] border border-line bg-surface-subtle p-5">
        <div class="flex items-start gap-3">
          <Icon name="shield" size={18} class="mt-0.5 shrink-0 text-accent" />
          <div>
            <p class="text-sm font-bold text-ink">Keep your account secure</p>
            <p class="mt-1 text-[13px] leading-relaxed text-muted">
              We will never ask for your password or wallet PIN. Report anything
              suspicious to support immediately.
            </p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</DashboardLayout>
