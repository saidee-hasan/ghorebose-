---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import OrderTimeline from "@/components/dashboard/OrderTimeline.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import CopyButton from "@/components/react/CopyButton";
import { orders, getOrder } from "@/data/orders";
import { getTool } from "@/data/tools";
import { formatBDT, formatDateTime, formatDate } from "@/lib/format";

export function getStaticPaths() {
  return orders.map((order) => ({ params: { id: order.id } }));
}

const { id } = Astro.params;
const order = getOrder(id!)!;
const tool = getTool(order.toolSlug);

const details = [
  { label: "Order ID", value: order.id, mono: true },
  { label: "Product", value: order.toolName },
  { label: "Plan", value: order.plan },
  { label: "Duration", value: order.duration },
  { label: "Price", value: formatBDT(order.amount) },
  { label: "Payment method", value: order.method },
  { label: "Transaction ID", value: order.trxId, mono: true },
  { label: "Order date", value: formatDateTime(order.createdAt) },
  { label: "Expires", value: formatDate(order.expiresAt) },
];
---

<DashboardLayout
  title={`Order ${order.id}`}
  active="orders"
  heading={`Order ${order.id}`}
  description="Full details and progress for this order."
>
  <Fragment slot="actions">
    <Button href="/dashboard/orders" variant="outline" size="sm" icon="arrow-left">
      Back to orders
    </Button>
    <Button href="#" size="sm" icon="download">Invoice</Button>
  </Fragment>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
    <div class="space-y-6">
      <!-- Summary -->
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex items-center gap-4">
            <span
              class:list={[
                "inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-[14px] font-display text-base font-extrabold",
                tool?.tone === "brand"
                  ? "bg-accent text-white"
                  : tool?.tone === "outline"
                    ? "border border-line-strong bg-white text-ink"
                    : "bg-ink text-white",
              ]}
            >
              {tool?.mark ?? "AI"}
            </span>
            <div>
              <h2 class="font-display text-lg font-bold text-ink">{order.toolName}</h2>
              <p class="text-sm text-muted">{order.plan} · {order.duration}</p>
              <a
                href={`/tools/${order.toolSlug}`}
                class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-accent hover:text-accent-hover"
              >
                View tool page <Icon name="arrow-up-right" size={12} />
              </a>
            </div>
          </div>
          <div class="text-right">
            <p class="font-display text-2xl font-extrabold text-ink">
              {formatBDT(order.amount)}
            </p>
            <div class="mt-2 flex justify-end gap-2">
              <StatusBadge type="order" status={order.status} />
            </div>
          </div>
        </div>
      </div>

      <!-- Details -->
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <h2 class="font-display text-base font-bold text-ink">Order information</h2>
        <dl class="mt-4 grid gap-x-8 gap-y-0 sm:grid-cols-2">
          {
            details.map((d) => (
              <div class="flex items-center justify-between gap-4 border-b border-line py-3">
                <dt class="text-sm text-muted">{d.label}</dt>
                <dd
                  class:list={[
                    "text-sm font-semibold text-ink",
                    d.mono && "font-mono",
                  ]}
                >
                  {d.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-5 flex flex-wrap items-center gap-3 rounded-[12px] border border-line bg-surface-subtle p-4">
          <div class="flex-1">
            <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-muted">
              Transaction ID
            </p>
            <p class="mt-0.5 font-mono text-sm font-semibold text-ink">{order.trxId}</p>
          </div>
          <CopyButton client:load value={order.trxId} label="Copy" />
        </div>
      </div>

      <!-- Timeline -->
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs sm:p-6">
        <h2 class="font-display text-base font-bold text-ink">Order timeline</h2>
        <OrderTimeline events={order.timeline} class="mt-5" />
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="space-y-4">
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
        <h2 class="font-display text-base font-bold text-ink">Payment status</h2>
        <div class="mt-3">
          <StatusBadge type="payment" status={order.paymentStatus} />
        </div>
        <p class="mt-3 text-[13px] leading-relaxed text-muted">
          {
            order.paymentStatus === "submitted"
              ? "Your payment is being reviewed by our admin team. Access will be delivered once verified."
              : order.paymentStatus === "rejected"
                ? "We could not verify this payment. A full refund has been issued to your payment number."
                : "Your payment has been verified and access has been delivered to your account."
          }
        </p>
        <div class="mt-4 space-y-2">
          <Button href="/contact" variant="outline" size="sm" block icon="message-square">
            Contact support
          </Button>
          {
            (order.paymentStatus === "delivered" ||
              order.paymentStatus === "completed") && (
              <Button href="/dashboard/purchased" size="sm" block icon="key">
                Access tool
              </Button>
            )
          }
        </div>
      </div>

      <div class="rounded-[16px] border border-line bg-surface-subtle p-5">
        <h3 class="text-sm font-bold text-ink">Need help?</h3>
        <p class="mt-1 text-[13px] leading-relaxed text-muted">
          Quote order <span class="font-mono font-semibold text-ink">{order.id}</span>{" "}
          when contacting support for the fastest resolution.
        </p>
      </div>
    </aside>
  </div>
</DashboardLayout>
