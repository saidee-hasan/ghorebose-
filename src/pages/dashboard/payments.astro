---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import Button from "@/components/ui/Button.astro";
import { getUserOrders } from "@/data/orders";
import { formatBDT, formatDateTime } from "@/lib/format";

const orders = getUserOrders();
const total = orders
  .filter((o) => o.status === "completed")
  .reduce((s, o) => s + o.amount, 0);
---

<DashboardLayout
  title="Payment History"
  active="payments"
  heading="Payment History"
  description="Every payment you have submitted, with verification status."
>
  <Fragment slot="actions">
    <Button href="#" variant="outline" icon="download">Export CSV</Button>
  </Fragment>

  <div class="mb-6 grid gap-4 sm:grid-cols-3">
    <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
      <p class="text-[13px] font-medium text-muted">Total paid</p>
      <p class="mt-1 font-display text-2xl font-extrabold text-ink">{formatBDT(total)}</p>
    </div>
    <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
      <p class="text-[13px] font-medium text-muted">Payments submitted</p>
      <p class="mt-1 font-display text-2xl font-extrabold text-ink">{orders.length}</p>
    </div>
    <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
      <p class="text-[13px] font-medium text-muted">Pending verification</p>
      <p class="mt-1 font-display text-2xl font-extrabold text-ink">
        {orders.filter((o) => o.paymentStatus === "submitted").length}
      </p>
    </div>
  </div>

  <div class="overflow-hidden rounded-[16px] border border-line bg-white shadow-xs">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead>
          <tr class="border-b border-line bg-surface-subtle text-[11px] font-bold uppercase tracking-[0.08em] text-muted">
            <th class="px-5 py-3.5">Order ID</th>
            <th class="px-5 py-3.5">Tool</th>
            <th class="px-5 py-3.5">Method</th>
            <th class="px-5 py-3.5">Transaction ID</th>
            <th class="px-5 py-3.5">Amount</th>
            <th class="px-5 py-3.5">Date</th>
            <th class="px-5 py-3.5">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            orders.map((o) => (
              <tr class="transition-colors hover:bg-surface-subtle">
                <td class="px-5 py-4">
                  <a
                    href={`/dashboard/orders/${o.id}`}
                    class="font-mono text-[13px] font-semibold text-ink hover:text-accent"
                  >
                    {o.id}
                  </a>
                </td>
                <td class="px-5 py-4 font-medium text-ink">{o.toolName}</td>
                <td class="px-5 py-4 text-muted">{o.method}</td>
                <td class="px-5 py-4 font-mono text-xs text-muted">{o.trxId}</td>
                <td class="px-5 py-4 font-semibold text-ink">{formatBDT(o.amount)}</td>
                <td class="px-5 py-4 text-muted">{formatDateTime(o.createdAt)}</td>
                <td class="px-5 py-4">
                  <StatusBadge type="payment" status={o.paymentStatus} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>
