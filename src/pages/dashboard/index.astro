---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import StatCard from "@/components/dashboard/StatCard.astro";
import OrdersTable from "@/components/dashboard/OrdersTable.astro";
import PurchasedToolCard from "@/components/dashboard/PurchasedToolCard.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { currentUser, getUserOrders, getPurchasedOrders, orderStats } from "@/data/orders";
import { formatBDT } from "@/lib/format";

const orders = getUserOrders();
const recent = orders.slice(0, 5);
const purchased = getPurchasedOrders().slice(0, 3);

const cards = [
  { label: "Total Orders", value: String(orderStats.totalOrders), icon: "package", trend: "+2 this month", accent: false },
  { label: "Active Tools", value: String(orderStats.activeTools), icon: "key", trend: "All healthy", accent: true },
  { label: "Pending Orders", value: String(orderStats.pendingOrders), icon: "clock", trend: "Awaiting review", accent: false },
  { label: "Total Spent", value: formatBDT(orderStats.totalSpent), icon: "wallet", trend: "+12% vs last", accent: false },
];

const quickActions = [
  { label: "Browse tools", href: "/tools", icon: "grid" },
  { label: "Payment history", href: "/dashboard/payments", icon: "credit-card" },
  { label: "Update profile", href: "/dashboard/profile", icon: "user" },
];
---

<DashboardLayout
  title="Dashboard"
  active="dashboard"
  heading={`Welcome back, ${currentUser.firstName}`}
  description="Here's what's happening with your orders and subscriptions."
>
  <Fragment slot="actions">
    <Button href="/tools" icon="search">Browse AI tools</Button>
  </Fragment>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {cards.map((c) => <StatCard {...c} />)}
  </div>

  <!-- Pending notice -->
  {
    orderStats.pendingOrders > 0 && (
      <div class="mt-6 flex flex-col items-start justify-between gap-4 rounded-[16px] border border-brand-200 bg-brand-50 p-5 sm:flex-row sm:items-center">
        <div class="flex items-start gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-[11px] bg-white text-brand-700">
            <Icon name="clock" size={19} />
          </span>
          <div>
            <p class="text-sm font-bold text-brand-800">
              {orderStats.pendingOrders} order{orderStats.pendingOrders > 1 ? "s" : ""} awaiting payment verification
            </p>
            <p class="mt-0.5 text-[13px] text-brand-800/80">
              Our admin team is reviewing your transaction. This usually takes 10–30 minutes.
            </p>
          </div>
        </div>
        <Button href="/dashboard/orders" variant="outline" size="sm" class="shrink-0">
          View orders
        </Button>
      </div>
    )
  }

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-display text-lg font-bold text-ink">Recent orders</h2>
        <a href="/dashboard/orders" class="text-sm font-semibold text-accent hover:text-accent-hover">
          View all
        </a>
      </div>
      <OrdersTable orders={recent} />
    </section>

    <aside class="space-y-6">
      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
        <h2 class="font-display text-base font-bold text-ink">Quick actions</h2>
        <div class="mt-4 space-y-2">
          {
            quickActions.map((a) => (
              <a
                href={a.href}
                class="flex items-center gap-3 rounded-[10px] border border-line px-3.5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-surface-subtle"
              >
                <Icon name={a.icon} size={17} class="text-muted" />
                {a.label}
                <Icon name="arrow-right" size={15} class="ml-auto text-muted" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="rounded-[16px] border border-line bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between">
          <h2 class="font-display text-base font-bold text-ink">Active subscriptions</h2>
          <a href="/dashboard/subscriptions" class="text-xs font-semibold text-accent hover:text-accent-hover">
            Manage
          </a>
        </div>
        <div class="mt-4 space-y-3">
          {
            purchased.map((o) => (
              <div class="flex items-center gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[10px] bg-surface-muted text-[11px] font-bold text-ink">
                  {o.toolName.slice(0, 2)}
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-[13px] font-semibold text-ink">{o.toolName}</p>
                  <p class="text-[11px] text-muted">Expires soon</p>
                </div>
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              </div>
            ))
          }
        </div>
      </div>
    </aside>
  </div>

  <section class="mt-8">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="font-display text-lg font-bold text-ink">Recently purchased tools</h2>
      <a href="/dashboard/purchased" class="text-sm font-semibold text-accent hover:text-accent-hover">
        View all
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {purchased.map((o) => <PurchasedToolCard order={o} />)}
    </div>
  </section>
</DashboardLayout>
