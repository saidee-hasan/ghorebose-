---
import BaseLayout from "./BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Avatar from "@/components/ui/Avatar.astro";

interface Props {
  title: string;
  active?: string;
  heading?: string;
  description?: string;
}

const { title, active, heading, description } = Astro.props;

const nav = [
  { key: "dashboard", label: "Dashboard", href: "/admin", icon: "grid" },
  { key: "tools", label: "Tools", href: "/admin/tools", icon: "layers" },
  { key: "categories", label: "Categories", href: "/admin/categories", icon: "tag" },
  { key: "orders", label: "Orders", href: "/admin/orders", icon: "package" },
  { key: "payments", label: "Payments", href: "/admin/payments", icon: "credit-card" },
  { key: "customers", label: "Customers", href: "/admin/customers", icon: "users" },
  { key: "subscriptions", label: "Subscriptions", href: "/admin/subscriptions", icon: "refresh" },
  { key: "reviews", label: "Reviews", href: "/admin/reviews", icon: "star" },
  { key: "coupons", label: "Coupons", href: "/admin/coupons", icon: "percent" },
  { key: "blog", label: "Blog", href: "/admin/blog", icon: "book" },
  { key: "settings", label: "Settings", href: "/admin/settings", icon: "settings" },
];
---

<BaseLayout title={title} bodyClass="bg-surface-subtle">
  <div class="flex min-h-screen">
    <!-- Admin sidebar -->
    <aside
      class="sticky top-0 hidden h-screen w-64 shrink-0 flex-col border-r border-line bg-white lg:flex"
    >
      <div class="flex h-16 items-center border-b border-line px-5">
        <a
          href="/"
          class="font-display text-lg font-extrabold tracking-tight text-ink"
        >
          ghorebose<span class="text-accent">.com</span>
        </a>
        <span
          class="ml-2 rounded-full border border-line bg-surface-muted px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-muted"
        >
          Admin
        </span>
      </div>
      <nav class="flex-1 space-y-0.5 overflow-y-auto p-3" aria-label="Admin">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 rounded-[10px] px-3 py-2.5 text-sm font-semibold transition-colors",
                active === item.key
                  ? "bg-ink text-white"
                  : "text-muted-strong hover:bg-surface-subtle hover:text-ink",
              ]}
            >
              <Icon name={item.icon} size={18} />
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="border-t border-line p-3">
        <div class="flex items-center gap-3 rounded-[12px] bg-surface-subtle p-3">
          <Avatar initials="AD" size="sm" variant="brand" />
          <div class="min-w-0">
            <p class="truncate text-[13px] font-bold text-ink">Admin Team</p>
            <p class="truncate text-[11px] text-muted">admin@ghorebose.com</p>
          </div>
        </div>
      </div>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
      <!-- Top bar -->
      <header
        class="sticky top-0 z-50 border-b border-line bg-white/90 backdrop-blur-md"
      >
        <div class="flex h-16 items-center justify-between gap-4 px-4 sm:px-6">
          <div class="flex items-center gap-3">
            <a
              href="/"
              class="font-display text-base font-extrabold tracking-tight text-ink lg:hidden"
            >
              ghorebose<span class="text-accent">.com</span>
            </a>
            <div
              class="hidden items-center gap-2 rounded-[10px] border border-line bg-surface-subtle px-3 py-2 text-sm text-muted sm:flex"
            >
              <Icon name="search" size={16} />
              <span>Search orders, tools, customers...</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <a
              href="/"
              class="hidden h-10 items-center justify-center rounded-[10px] border border-line px-3.5 text-[13px] font-semibold text-ink transition-colors hover:bg-surface-subtle sm:inline-flex"
            >
              View store
            </a>
            <button
              type="button"
              aria-label="Notifications"
              class="relative inline-flex h-10 w-10 items-center justify-center rounded-[10px] text-ink transition-colors hover:bg-surface-muted"
            >
              <Icon name="bell" size={20} />
              <span
                class="absolute right-2 top-2 h-2 w-2 rounded-full bg-accent ring-2 ring-white"
              ></span>
            </button>
            <Avatar initials="AD" size="sm" variant="ink" />
          </div>
        </div>

        <!-- Mobile admin nav -->
        <nav
          class="no-scrollbar flex gap-2 overflow-x-auto border-t border-line px-4 py-2.5 lg:hidden"
          aria-label="Admin mobile"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "inline-flex shrink-0 items-center gap-2 rounded-full border px-3.5 py-1.5 text-[12px] font-semibold transition-colors",
                  active === item.key
                    ? "border-ink bg-ink text-white"
                    : "border-line bg-white text-muted-strong",
                ]}
              >
                <Icon name={item.icon} size={14} />
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main id="main" class="flex-1 p-4 sm:p-6 lg:p-8">
        {
          heading && (
            <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
              <div>
                <h1 class="font-display text-2xl font-extrabold tracking-tight text-ink">
                  {heading}
                </h1>
                {description && (
                  <p class="mt-1 text-sm text-muted">{description}</p>
                )}
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <slot name="actions" />
              </div>
            </div>
          )
        }
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
