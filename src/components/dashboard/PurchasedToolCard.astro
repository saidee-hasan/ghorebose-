---
import Icon from "@/components/ui/Icon.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import { formatDate, daysUntil } from "@/lib/format";
import type { Order } from "@/lib/types";
import { getTool } from "@/data/tools";

interface Props {
  order: Order;
  class?: string;
}

const { order, class: className = "" } = Astro.props;
const tool = getTool(order.toolSlug);
const remaining = daysUntil(order.expiresAt);
const active = remaining > 0;
---

<div
  class:list={[
    "flex flex-col rounded-[16px] border border-line bg-white p-5 shadow-xs transition-shadow hover:shadow-sm",
    className,
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3">
      <span
        class:list={[
          "inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-[12px] font-display text-sm font-extrabold",
          tool?.tone === "brand"
            ? "bg-accent text-white"
            : tool?.tone === "outline"
              ? "border border-line-strong bg-white text-ink"
              : "bg-ink text-white",
        ]}
      >
        {tool?.mark ?? "AI"}
      </span>
      <div class="min-w-0">
        <h3 class="truncate font-display text-[15px] font-bold text-ink">
          {order.toolName}
        </h3>
        <p class="text-xs text-muted">{order.plan} · {order.duration}</p>
      </div>
    </div>
    <StatusBadge
      type="payment"
      status={active ? "delivered" : "completed"}
    />
  </div>

  <dl class="mt-4 grid grid-cols-2 gap-3 border-y border-line py-4 text-xs">
    <div>
      <dt class="text-muted">Order ID</dt>
      <dd class="mt-0.5 font-semibold text-ink">{order.id}</dd>
    </div>
    <div>
      <dt class="text-muted">Purchased</dt>
      <dd class="mt-0.5 font-semibold text-ink">{formatDate(order.createdAt)}</dd>
    </div>
    <div>
      <dt class="text-muted">Expires</dt>
      <dd class="mt-0.5 font-semibold text-ink">{formatDate(order.expiresAt)}</dd>
    </div>
    <div>
      <dt class="text-muted">Status</dt>
      <dd class:list={["mt-0.5 font-semibold", active ? "text-ink" : "text-muted"]}>
        {active ? `${remaining} days left` : "Expired"}
      </dd>
    </div>
  </dl>

  <div class="mt-4 grid grid-cols-2 gap-2.5">
    <a
      href={`/dashboard/orders/${order.id}`}
      class="inline-flex h-10 items-center justify-center rounded-[10px] border border-line bg-white text-[13px] font-semibold text-ink transition-colors hover:bg-surface-subtle"
    >
      View Details
    </a>
    <a
      href="#"
      class="inline-flex h-10 items-center justify-center gap-1.5 rounded-[10px] bg-accent text-[13px] font-semibold text-white transition-colors hover:bg-accent-hover"
    >
      <Icon name="external-link" size={15} />
      Access Tool
    </a>
  </div>
</div>
