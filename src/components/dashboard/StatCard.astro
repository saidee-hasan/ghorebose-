---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  label: string;
  value: string;
  icon: string;
  hint?: string;
  trend?: string;
  trendUp?: boolean;
  accent?: boolean;
  class?: string;
}

const {
  label,
  value,
  icon,
  hint,
  trend,
  trendUp = true,
  accent = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "rounded-[16px] border border-line bg-white p-5 shadow-xs",
    className,
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <span
      class:list={[
        "inline-flex h-10 w-10 items-center justify-center rounded-[11px]",
        accent ? "bg-accent text-white" : "bg-surface-muted text-ink",
      ]}
    >
      <Icon name={icon} size={19} />
    </span>
    {
      trend && (
        <span
          class:list={[
            "inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-bold",
            trendUp
              ? "border-brand-200 bg-brand-50 text-brand-700"
              : "border-line bg-surface-muted text-muted-strong",
          ]}
        >
          <Icon name={trendUp ? "trending-up" : "minus"} size={12} />
          {trend}
        </span>
      )
    }
  </div>
  <p class="mt-4 font-display text-2xl font-extrabold tracking-tight text-ink">
    {value}
  </p>
  <p class="mt-0.5 text-[13px] font-medium text-muted">{label}</p>
  {hint && <p class="mt-2 border-t border-line pt-2 text-[11px] text-muted">{hint}</p>}
</div>
