---
interface Props {
  rating: number;
  count?: number;
  size?: number;
  showValue?: boolean;
  class?: string;
}

const {
  rating,
  count,
  size = 14,
  showValue = false,
  class: className = "",
} = Astro.props;

const stars = [1, 2, 3, 4, 5];
const cls = ["inline-flex items-center gap-1", className].filter(Boolean).join(" ");
---

<div class={cls}>
  <div class="flex items-center gap-0.5" aria-label={`${rating} out of 5 stars`}>
    {
      stars.map((s) => {
        const fill = Math.max(0, Math.min(1, rating - (s - 1)));
        return (
          <span class="relative inline-block" style={`width:${size}px;height:${size}px`}>
            <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="#E5E7EB" stroke-width="1.5" class="absolute inset-0">
              <path d="M11.5 2.5 14.3 8l6.2.9-4.5 4.3 1.1 6.1-5.6-2.9-5.6 2.9 1.1-6.1L2.5 8.9 8.7 8z" />
            </svg>
            <span class="absolute inset-0 overflow-hidden" style={`width:${fill * 100}%`}>
              <svg viewBox="0 0 24 24" width={size} height={size} fill="#F97316" stroke="#F97316" stroke-width="1.5">
                <path d="M11.5 2.5 14.3 8l6.2.9-4.5 4.3 1.1 6.1-5.6-2.9-5.6 2.9 1.1-6.1L2.5 8.9 8.7 8z" />
              </svg>
            </span>
          </span>
        );
      })
    }
  </div>
  {showValue && <span class="text-xs font-semibold text-ink">{rating.toFixed(1)}</span>}
  {count !== undefined && <span class="text-xs text-muted">({count})</span>}
</div>
