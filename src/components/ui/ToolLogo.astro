---
interface Props {
  mark: string;
  tone?: "ink" | "brand" | "outline";
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const { mark, tone = "ink", size = "md", class: className = "" } = Astro.props;

const sizes: Record<string, string> = {
  sm: "h-9 w-9 text-xs rounded-[10px]",
  md: "h-12 w-12 text-sm rounded-[12px]",
  lg: "h-16 w-16 text-lg rounded-[14px]",
  xl: "h-20 w-20 text-2xl rounded-[18px]",
};

const tones: Record<string, string> = {
  ink: "bg-ink text-white",
  brand: "bg-accent text-white",
  outline: "bg-white text-ink border border-line-strong",
};

const cls = [
  "inline-flex shrink-0 items-center justify-center font-display font-extrabold tracking-tight",
  sizes[size],
  tones[tone],
  className,
]
  .filter(Boolean)
  .join(" ");
---

<span class={cls} aria-hidden="true">{mark}</span>
