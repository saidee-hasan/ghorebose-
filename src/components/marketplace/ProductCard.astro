---
import type { Tool } from "@/lib/types";
import Rating from "@/components/ui/Rating.astro";
import Icon from "@/components/ui/Icon.astro";
import { getCategoryName } from "@/data/categories";
import { formatBDT, billingLabel } from "@/lib/format";

interface Props {
  tool: Tool;
  class?: string;
}

const { tool, class: className = "" } = Astro.props;

const catName = getCategoryName(tool.category);
const discount = tool.compareAtPrice
  ? Math.round((1 - tool.price / tool.compareAtPrice) * 100)
  : 0;

const badge: Record<string, string> = {
  trending: "Trending",
  new: "New",
  popular: "Popular",
  "best-value": "Best Value",
  "editor-choice": "Editor's Choice",
};
---

<article
  class:list={[
    "group flex flex-col overflow-hidden rounded-[18px] border border-line bg-white shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-line-strong hover:shadow-lg",
    className,
  ]}
>
  <!-- Image -->
  <a
    href={`/tools/${tool.slug}`}
    class="relative block aspect-[16/11] overflow-hidden bg-surface-subtle"
    aria-label={`View ${tool.name}`}
  >
    <img
      src={`/covers/${tool.slug}.svg`}
      alt={`${tool.name} — ${catName}`}
      width="800"
      height="500"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
    />

    <!-- top-left badges -->
    <div class="absolute left-3 top-3 flex flex-col items-start gap-2">
      {
        tool.isFree ? (
          <span class="rounded-full bg-accent px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-white shadow-sm">
            Free
          </span>
        ) : discount > 0 ? (
          <span class="rounded-full bg-ink px-3 py-1 text-[11px] font-bold tracking-wide text-white shadow-sm">
            −{discount}%
          </span>
        ) : null
      }
      {
        tool.badge && (
          <span class="rounded-full border border-line bg-white/95 px-3 py-1 text-[11px] font-bold tracking-wide text-ink shadow-sm backdrop-blur">
            {badge[tool.badge]}
          </span>
        )
      }
    </div>

    <!-- wishlist -->
    <span
      class="absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white/95 text-muted shadow-sm backdrop-blur transition-colors group-hover:text-accent"
      aria-hidden="true"
    >
      <Icon name="heart" size={16} />
    </span>
  </a>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center justify-between gap-3">
      <a
        href={`/category/${tool.category}`}
        class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent transition-colors hover:text-accent-hover"
      >
        {catName}
      </a>
      <Rating rating={tool.rating} count={tool.reviewCount} showValue />
    </div>

    <h3 class="mt-3 font-display text-lg font-extrabold leading-snug tracking-tight text-ink">
      <a href={`/tools/${tool.slug}`} class="transition-colors hover:text-accent">
        {tool.name}
      </a>
    </h3>

    <!-- price -->
    <div class="mt-4 flex items-end justify-between gap-3 border-t border-line pt-4">
      <div>
        <div class="flex items-baseline gap-2">
          <span class="font-display text-2xl font-extrabold tracking-tight text-accent">
            {tool.isFree ? "Free" : formatBDT(tool.price)}
          </span>
          {
            !tool.isFree && (
              <span class="text-xs font-medium text-muted">
                {billingLabel(tool.billing)}
              </span>
            )
          }
          {
            tool.compareAtPrice && (
              <span class="text-xs font-medium text-muted line-through">
                {formatBDT(tool.compareAtPrice)}
              </span>
            )
          }
        </div>
        <p class="mt-1 flex items-center gap-1 text-[11px] text-muted">
          <Icon name="users" size={12} />
          {tool.userCount} buyers
        </p>
      </div>
    </div>

    <!-- actions -->
    <div class="mt-4 grid grid-cols-2 gap-2.5">
      <a
        href={`/tools/${tool.slug}`}
        class="inline-flex h-11 items-center justify-center rounded-[10px] border border-line bg-white text-[13px] font-semibold text-ink transition-colors hover:border-line-strong hover:bg-surface-subtle"
      >
        View Details
      </a>
      <a
        href={tool.isFree ? `/tools/${tool.slug}` : `/checkout/${tool.slug}`}
        class="inline-flex h-11 items-center justify-center gap-1.5 rounded-[10px] bg-accent text-[13px] font-semibold text-white transition-colors hover:bg-accent-hover"
      >
        <Icon name="cart" size={15} />
        {tool.isFree ? "Get Free" : "Buy Now"}
      </a>
    </div>
  </div>
</article>
