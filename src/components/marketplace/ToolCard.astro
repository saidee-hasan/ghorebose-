---
import type { Tool } from "@/lib/types";
import { getCategoryName } from "@/data/categories";
import { formatBDT } from "@/lib/format";

interface Props {
  tool: Tool;
  variant?: "default" | "compact";
  class?: string;
}

const { tool, variant = "default", class: className = "" } = Astro.props;

const catName = getCategoryName(tool.category);
const discount = tool.compareAtPrice
  ? Math.round((1 - tool.price / tool.compareAtPrice) * 100)
  : 0;

const stockCount = tool.stock || 15;
const durationLabel = tool.duration
  ? tool.duration
  : tool.billing === "one-time"
    ? "One-time"
    : "Month";
---

<article
  class:list={[
    "group flex flex-col overflow-hidden rounded-[14px] sm:rounded-[18px] border border-line bg-white shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-line-strong hover:shadow-lg",
    className,
  ]}
>
  <!-- eCommerce Cover Image -->
  <a href={`/tools/${tool.slug}`} class="relative block aspect-[16/10] overflow-hidden bg-surface-subtle">
    <img
      src={`/covers/${tool.slug}.svg`}
      alt={tool.name}
      width="400"
      height="250"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
    />

    <!-- Top Badges Overlay -->
    <div class="absolute left-2 top-2 flex flex-col gap-1">
      {
        tool.isFree ? (
          <span class="rounded-full bg-accent px-2 py-0.5 text-[9px] sm:text-[10px] font-bold text-white shadow-xs uppercase tracking-wide">
            FREE
          </span>
        ) : (
          discount > 0 && (
            <span class="rounded-full bg-ink px-2 py-0.5 text-[9px] sm:text-[10px] font-bold text-white shadow-xs">
              −{discount}%
            </span>
          )
        )
      }
    </div>

    <!-- Stock Badge on Top Right -->
    <div class="absolute right-2 top-2">
      <span class="inline-flex items-center gap-1 rounded-full bg-white/95 px-2 py-0.5 text-[9px] sm:text-[10px] font-bold text-emerald-800 shadow-xs backdrop-blur font-bangla">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        স্টক: {stockCount}
      </span>
    </div>
  </a>

  <!-- Card Content Body -->
  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <div class="flex items-center justify-between gap-1">
      <a
        href={`/category/${tool.category}`}
        class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-accent truncate hover:underline"
      >
        {catName}
      </a>
      <div class="flex items-center gap-0.5" aria-label={`${tool.rating} out of 5`}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="#F97316" stroke="#F97316" stroke-width="1.5">
          <path d="M11.5 2.5 14.3 8l6.2.9-4.5 4.3 1.1 6.1-5.6-2.9-5.6 2.9 1.1-6.1L2.5 8.9 8.7 8z"></path>
        </svg>
        <span class="text-[11px] sm:text-xs font-bold text-ink">{tool.rating.toFixed(1)}</span>
      </div>
    </div>

    <h3 class="mt-1.5 font-display text-xs sm:text-[15px] font-extrabold text-ink group-hover:text-accent transition-colors truncate">
      <a href={`/tools/${tool.slug}`}>{tool.name}</a>
    </h3>

    <!-- Duration & Stock Status -->
    <div class="mt-2 flex items-center justify-between text-[10px] sm:text-[11px] text-muted font-bangla border-t border-line/60 pt-2">
      <span class="text-emerald-700 font-semibold">⚡ ইনস্ট্যান্ট ডেলিভারি</span>
      <span class="font-medium bg-surface-muted px-1.5 py-0.5 rounded text-muted-strong">{durationLabel}</span>
    </div>

    <!-- Price Section with Eye-catching User-friendly Color -->
    <div class="mt-2.5 flex items-baseline justify-between border-t border-line pt-2.5">
      <div class="flex items-baseline gap-1">
        <span class="font-display text-sm sm:text-lg font-extrabold tracking-tight text-accent">
          {tool.isFree ? "Free" : formatBDT(tool.price)}
        </span>
        {
          !tool.isFree && (
            <span class="text-[10px] sm:text-xs font-medium text-muted">/{durationLabel}</span>
          )
        }
      </div>
      {
        tool.compareAtPrice && (
          <span class="text-[10px] sm:text-xs text-muted line-through">{formatBDT(tool.compareAtPrice)}</span>
        )
      }
    </div>

    <!-- 2 Action Buttons -->
    <div class="mt-3 grid grid-cols-2 gap-1.5 sm:gap-2">
      <a
        href={`/tools/${tool.slug}`}
        class="inline-flex h-8 sm:h-9 items-center justify-center rounded-[8px] sm:rounded-[10px] border border-line bg-white text-[11px] sm:text-xs font-semibold text-ink transition-colors hover:bg-surface-subtle hover:border-line-strong"
      >
        Details
      </a>
      <a
        href={tool.isFree ? `/tools/${tool.slug}` : `/checkout/${tool.slug}`}
        class="inline-flex h-8 sm:h-9 items-center justify-center rounded-[8px] sm:rounded-[10px] bg-accent text-[11px] sm:text-xs font-bold text-white transition-colors hover:bg-accent-hover shadow-xs"
      >
        {tool.isFree ? "Free" : "Buy Now"}
      </a>
    </div>
  </div>
</article>
